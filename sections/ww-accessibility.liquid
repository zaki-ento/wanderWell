{% comment %}
  Section: WW Accessibility
  Description: Custom page section outlining accessibility commitments, list of features, and a feedback block.
{% endcomment %}

<div class="ww-accessibility section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="container max-w-breakpoint-md">
    
    <div class="ww-accessibility__content">
      {%- if section.settings.label != blank -%}
        <div class="ww-accessibility__label-wrapper">
          <span class="ww-accessibility__label">{{ section.settings.label | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ww-accessibility__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ww-accessibility__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.list_heading != blank -%}
        <h3 class="ww-accessibility__list-heading">{{ section.settings.list_heading | escape }}</h3>
      {%- endif -%}

      {%- assign bullet_points = section.blocks | filter: 'bullet_point' -%}
      {%- if bullet_points.size > 0 -%}
        <ul class="ww-accessibility__list">
          {%- for block in bullet_points -%}
            <li class="ww-accessibility__list-item" {{ block.shopify_attributes }}>
              <span class="ww-accessibility__dot"></span>
              <div class="ww-accessibility__list-content">
                {%- if block.settings.title != blank -%}
                  <strong class="ww-accessibility__list-title">{{ block.settings.title | escape }} </strong>
                {%- endif -%}
                {{ block.settings.text | escape }}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.feedback_title != blank or section.settings.feedback_text != blank -%}
        <div class="ww-accessibility__feedback-card">
          {%- if section.settings.feedback_title != blank -%}
            <h4 class="ww-accessibility__feedback-title">{{ section.settings.feedback_title | escape }}</h4>
          {%- endif -%}
          {%- if section.settings.feedback_text != blank -%}
            <div class="ww-accessibility__feedback-text rte">
              {{ section.settings.feedback_text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .ww-accessibility {
    padding: 80px 0 100px;
    background-color: var(--cream);
  }
  .ww-accessibility__content {
    max-width: 760px;
    margin: 0 auto;
  }
  .ww-accessibility__label-wrapper {
    margin-bottom: 40px;
  }
  .ww-accessibility__label {
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    background-color: #E8DFD0;
    padding: 6px 14px;
    border-radius: 4px;
  }
  .ww-accessibility__heading {
    font-family: var(--font-primary);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--charcoal);
    margin: 0 0 24px 0;
    letter-spacing: -0.02em;
  }
  .ww-accessibility__description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--charcoal);
    margin-bottom: 56px;
  }
  .ww-accessibility__description p {
    margin: 0 0 1.5rem 0;
  }
  .ww-accessibility__description strong {
    font-weight: 600;
  }
  .ww-accessibility__list-heading {
    font-family: var(--font-primary);
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--charcoal);
    margin: 0 0 32px 0;
    letter-spacing: -0.02em;
  }
  .ww-accessibility__list {
    list-style: none;
    padding: 0;
    margin: 0 0 64px 0;
  }
  .ww-accessibility__list-item {
    position: relative;
    padding-left: 28px;
    margin-bottom: 24px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--charcoal);
    display: flex;
    align-items: flex-start;
  }
  .ww-accessibility__dot {
    position: absolute;
    left: 4px;
    top: 10px;
    width: 8px;
    height: 8px;
    background-color: var(--orange);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ww-accessibility__list-content {
    flex-grow: 1;
  }
  .ww-accessibility__list-title {
    font-weight: 600;
    color: var(--charcoal);
  }
  .ww-accessibility__feedback-card {
    background-color: var(--orange-pale);
    border-radius: var(--ww-radius-lg);
    padding: 40px 48px;
    border: 1px solid rgba(232, 99, 43, 0.1);
  }
  .ww-accessibility__feedback-title {
    font-family: var(--font-primary);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--charcoal);
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }
  .ww-accessibility__feedback-text {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--charcoal);
  }
  .ww-accessibility__feedback-text p {
    margin: 0;
  }
  .ww-accessibility__feedback-text strong {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .ww-accessibility {
      padding: 60px 0;
    }
    .ww-accessibility__heading {
      font-size: 1.85rem;
    }
    .ww-accessibility__list-heading {
      font-size: 1.5rem;
    }
    .ww-accessibility__feedback-card {
      padding: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WW Accessibility",
  "tag": "section",
  "class": "ww-section-accessibility",
  "settings": [
    {
      "type": "header",
      "content": "Commitment Section"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Accessibility"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our commitment"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Text",
      "default": "<p>We design and build shopwanderwell.co to meet the <strong>Web Content Accessibility Guidelines (WCAG) 2.1, Level AA</strong>. That's the same standard recommended by the U.S. Department of Justice for compliance with Title III of the Americans with Disabilities Act (ADA).</p>"
    },
    {
      "type": "header",
      "content": "Achievements Section"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "List Heading",
      "default": "What we've done"
    },
    {
      "type": "header",
      "content": "Feedback Card Section"
    },
    {
      "type": "text",
      "id": "feedback_title",
      "label": "Feedback Title",
      "default": "Found a barrier? Tell us."
    },
    {
      "type": "richtext",
      "id": "feedback_text",
      "label": "Feedback Text",
      "default": "<p>If something on shopwanderwell.co is hard to use, we want to hear about it — and we'll respond within <strong>5 business days</strong>. No automated brush-offs. A real person reads and answers every message.</p>"
    }
  ],
  "blocks": [
    {
      "type": "bullet_point",
      "name": "Bullet Point Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bold prefix text",
          "default": "Keyboard navigation."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Bullet Point Text",
          "default": "Every link, button, form field, and product card can be reached and activated with the keyboard alone. A visible focus ring shows where you are."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Accessibility",
      "blocks": [
        {
          "type": "bullet_point",
          "settings": {
            "title": "Keyboard navigation.",
            "text": "Every link, button, form field, and product card can be reached and activated with the keyboard alone. A visible focus ring shows where you are."
          }
        },
        {
          "type": "bullet_point",
          "settings": {
            "title": "Screen reader support.",
            "text": "Headings, landmarks, image alt text, and form labels are written for assistive technology. Interactive controls announce their state."
          }
        },
        {
          "type": "bullet_point",
          "settings": {
            "title": "Color contrast.",
            "text": "Text meets a 4.5:1 contrast ratio (3:1 for large headings) against its background."
          }
        },
        {
          "type": "bullet_point",
          "settings": {
            "title": "Reduced motion.",
            "text": "If you've turned on \"reduce motion\" in your operating system, our animations, tickers, and card flips quiet down automatically."
          }
        },
        {
          "type": "bullet_point",
          "settings": {
            "title": "Resizable text.",
            "text": "The site is responsive and remains usable when you zoom up to 200% or increase your default text size."
          }
        },
        {
          "type": "bullet_point",
          "settings": {
            "title": "Skip-to-content link.",
            "text": "Tab once and you can jump past the navigation straight to the page."
          }
        }
      ]
    }
  ]
}
{% endschema %}
