{% comment %}
  Section: WW Products Hub (Variant Architecture - Method 1)
  Description: Duplicated product hub testing Native Variant Architecture.
  - Variant A: 1 Pack ($29.99)
  - Variant B: 2 Pack ($59.98)
  - Appstle Subscription Plan strictly attached to 2-Pack ($53.99, save 10%)
  - Custom UI pairing with 2 radio options
  - Locks PDP quantity to 1 when Subscribe & Save is active
{% endcomment %}

{{ 'ww-product.css' | asset_url | stylesheet_tag }}
{% render 'add-to-cart-button-styles' %}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.layout_width == 'full' -%}
    .section-{{ section.id }} .container {
      max-width: none !important;
      width: 100%;
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}

  /* Desktop vs Mobile/Tablet Visibility */
  @media screen and (min-width: 1024px) {
    .section-{{ section.id }} .ww-shop__mobile {
      display: none !important;
    }
    .section-{{ section.id }} .ww-shop__desktop {
      display: block !important;
    }
  }

  @media screen and (max-width: 1023px) {
    .section-{{ section.id }} .ww-shop__desktop {
      display: none !important;
    }
    .section-{{ section.id }} .ww-shop__mobile {
      display: block !important;
    }
    .section-{{ section.id }} .ww-sticky-bar {
      display: none !important;
    }
    .section-{{ section.id }} .container {
      padding-left: 0 !important;
      padding-right: 0 !important;
      max-width: 100% !important;
    }
    .section-{{ section.id }} .products-header {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  /* Mobile/Tablet Carousel Styles */
  .ww-mob-carousel {
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .ww-mob-carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 20px 20px;
    gap: 16px;
    box-sizing: border-box;
  }

  .ww-mob-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .ww-mob-carousel__slide {
    flex: 0 0 calc(100vw - 64px);
    max-width: 380px;
    min-width: 280px;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: flex;
    box-sizing: border-box;
  }

  @media screen and (min-width: 480px) and (max-width: 1023px) {
    .ww-mob-carousel__track {
      padding: 10px max(24px, calc((100% - 380px) / 2)) 20px;
    }
    .ww-mob-carousel__slide {
      flex: 0 0 380px;
    }
  }

  .ww-mob-card {
    background: #FFFFFF;
    border-radius: 28px;
    padding: 14px 14px 20px 14px;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(44, 44, 44, 0.06);
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
  }

  .ww-mob-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #94A671;
    text-decoration: none;
  }

  .ww-mob-card__pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: var(--orange, #E8632B);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    line-height: 1;
    z-index: 3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .ww-mob-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ww-mob-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ww-mob-card__logo {
    color: #FFFFFF;
    font-family: var(--font-heading, inherit);
    font-size: 2.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    user-select: none;
  }

  .ww-mob-card__body {
    padding: 16px 6px 0 6px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ww-mob-card__eyebrow {
    color: var(--orange, #E8632B);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .ww-mob-card__title {
    font-size: 1.55rem;
    font-weight: 800;
    color: #1A1A1A;
    margin: 0 0 8px;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .ww-mob-card__desc {
    font-size: 0.92rem;
    line-height: 1.44;
    color: #555555;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .ww-mob-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 18px;
  }

  .ww-mob-card__price {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1A1A1A;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .ww-mob-card__serving-rate {
    font-size: 0.95rem;
    color: #7A7A7A;
    font-weight: 400;
  }

  .ww-mob-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: var(--orange, #E8632B);
    color: #FFFFFF !important;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    padding: 15px 20px;
    border-radius: 14px;
    box-sizing: border-box;
    transition: background-color 0.2s ease, transform 0.15s ease;
    cursor: pointer;
  }

  .ww-mob-card__cta:active {
    transform: scale(0.98);
    background-color: #D4541F;
  }

  .ww-mob-carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 18px 0 8px;
  }

  .ww-mob-carousel__dot {
    appearance: none;
    border: none;
    padding: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #D6D6D6;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease, border-radius 0.3s ease;
    cursor: pointer;
  }

  .ww-mob-carousel__dot.is-active {
    width: 26px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--orange, #E8632B);
  }
{%- endstyle -%}

<section id="ww-product-hub" class="ww-products ww-products--v2 section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="products-header">
      {%- if section.settings.label != blank -%}
        <span id="ww-products" class="section-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}

      <div class="products-badges">
        {%- if section.settings.badge_1_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21v-9"></path>
              <path d="M12 12c0-4 -3-6-7-6 0 4 3 6 7 6z"></path>
              <path d="M12 12c0-5 3-8 8-8 0 5-3 8-8 8z"></path>
            </svg>
            {{ section.settings.badge_1_text | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            {{ section.settings.badge_2_text | escape }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="ww-shop">
      {%- assign default_tab_id = '' -%}
      {%- assign first_tab_id = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_tab' -%}
          {%- if first_tab_id == '' -%}
            {%- assign first_tab_id = block.id -%}
          {%- endif -%}
          {%- assign p_obj = block.settings.product -%}
          {%- if p_obj == blank -%}
            {%- assign handle_guess = block.settings.title | handleize -%}
            {%- assign p_obj = all_products[handle_guess] -%}
            {%- if p_obj == blank and collections.all.products.size > 0 -%}
              {%- assign prod_idx = forloop.index0 | modulo: collections.all.products.size -%}
              {%- assign p_obj = collections.all.products[prod_idx] -%}
            {%- endif -%}
          {%- endif -%}
          {%- if p_obj.selling_plan_groups.size > 0 and default_tab_id == '' -%}
            {%- assign default_tab_id = block.id -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if default_tab_id == '' -%}
        {%- assign default_tab_id = first_tab_id -%}
      {%- endif -%}

      <div class="ww-shop__desktop">
        <div class="ww-seg-wrap">
        <div class="ww-seg" role="tablist" aria-label="Choose a product">
          <span class="ww-seg-ind" aria-hidden="true"></span>
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_tab' -%}
              {%- assign current_prod = block.settings.product -%}
              {%- if current_prod == blank -%}
                {%- assign handle_guess = block.settings.title | handleize -%}
                {%- assign current_prod = all_products[handle_guess] -%}
                {%- if current_prod == blank and collections.all.products.size > 0 -%}
                  {%- assign prod_idx = forloop.index0 | modulo: collections.all.products.size -%}
                  {%- assign current_prod = collections.all.products[prod_idx] -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign title = block.settings.title | default: current_prod.title -%}
              {%- assign subtitle = block.settings.subtitle
                | default: current_prod.metafields.custom.subtitle.value
                | default: current_prod.metafields.custom.subtitle
              -%}
              <button
                class="ww-seg-btn {% if block.id == default_tab_id %}on{% endif %}"
                data-prod="block-{{ block.id }}"
                role="tab"
                {{ block.shopify_attributes }}
              >
                {{ title | escape }}
                <span class="ww-seg-sub">{{ subtitle | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'product_tab' -%}
          {%- assign current_prod = block.settings.product -%}
          {%- if current_prod == blank -%}
            {%- assign handle_guess = block.settings.title | handleize -%}
            {%- assign current_prod = all_products[handle_guess] -%}
            {%- if current_prod == blank and collections.all.products.size > 0 -%}
              {%- assign prod_idx = forloop.index0 | modulo: collections.all.products.size -%}
              {%- assign current_prod = collections.all.products[prod_idx] -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign key = 'block-' | append: block.id -%}

          {%- assign title = block.settings.title | default: current_prod.title -%}
          {%- assign subtitle = block.settings.subtitle
            | default: current_prod.metafields.custom.subtitle.value
            | default: current_prod.metafields.custom.subtitle
          -%}
          {%- assign desc = block.settings.description | default: current_prod.description -%}

          <div
            class="ww-panel {% if block.id == default_tab_id %}on{% endif %}"
            data-prod="{{ key }}"
            role="tabpanel"
            {{ block.shopify_attributes }}
          >
            <div class="ww-panel-inner">
              <div class="ww-media">
                <div class="ww-media-main">
                  <div class="ww-media-stage">
                    {%- assign product_images = current_prod.images -%}

                    {%- if product_images.size > 0 -%}
                      {%- for image in product_images limit: 4 -%}
                        {%- assign slide_alt = image.alt | default: title | default: shop.name -%}
                        <div class="ww-media-slide {% if forloop.first %}is-on{% endif %}">
                          {{
                            image
                            | image_url: width: 800
                            | image_tag:
                              widths: '320, 480, 640, 800',
                              sizes: '(max-width: 768px) 90vw, 520px',
                              loading: 'lazy',
                              decoding: 'async',
                              alt: slide_alt
                          }}
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      <div class="ww-media-slide is-on">
                        {%- if settings.logo_inverse != blank -%}
                          {{
                            settings.logo_inverse
                            | image_url: width: 400
                            | image_tag: class: 'ww-media-logo', loading: 'lazy', decoding: 'async', alt: shop.name
                          }}
                        {%- endif -%}
                      </div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                    {%- endif -%}
                  </div>

                  {%- assign has_multiple_images = false -%}
                  {%- if product_images.size > 1 -%}
                    {%- assign has_multiple_images = true -%}
                  {%- endif -%}

                  {%- if has_multiple_images -%}
                    <button class="ww-media-nav ww-media-nav--prev" type="button" aria-label="Previous image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15 5l-7 7 7 7"></path>
                      </svg>
                    </button>
                    <button class="ww-media-nav ww-media-nav--next" type="button" aria-label="Next image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 5l7 7-7 7"></path>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>

                <div class="ww-media-thumbs" role="tablist" aria-label="Product image thumbnails">
                  {%- if product_images.size > 0 -%}
                    {%- for image in product_images limit: 4 -%}
                      {%- assign thumb_alt = image.alt
                        | default: title
                        | default: shop.name
                        | default: 'Product thumbnail'
                      -%}
                      <div
                        class="ww-media-thumb {% if forloop.first %}is-active{% endif %}"
                        role="tab"
                        tabindex="0"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-label="Thumbnail {{ forloop.index }} of {{ product_images.size }}"
                      >
                        {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: thumb_alt }}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    <div
                      class="ww-media-thumb is-active"
                      role="tab"
                      tabindex="0"
                      aria-selected="true"
                      aria-label="Product thumbnail 1"
                    ></div>
                    <div
                      class="ww-media-thumb"
                      role="tab"
                      tabindex="0"
                      aria-selected="false"
                      aria-label="Product thumbnail 2"
                    ></div>
                    <div
                      class="ww-media-thumb"
                      role="tab"
                      tabindex="0"
                      aria-selected="false"
                      aria-label="Product thumbnail 3"
                    ></div>
                    <div
                      class="ww-media-thumb"
                      role="tab"
                      tabindex="0"
                      aria-selected="false"
                      aria-label="Product thumbnail 4"
                    ></div>
                  {%- endif -%}
                </div>
              </div>

              <div class="ww-detail">
                <div class="ww-detail-eyebrow">{{ title | escape }} · {{ subtitle | escape }}</div>
                <h3 class="ww-detail-title">{{ title | escape }}</h3>

                {%- if desc != blank -%}
                  <p class="ww-detail-lede">{{ desc }}</p>
                {%- endif -%}

                {%- if current_prod != blank -%}
                  <div class="ww-buy">
                    {%- liquid
                      # Single simple product variant
                      assign current_variant = current_prod.selected_or_first_available_variant
                      assign initial_variant_id = current_variant.id

                      assign is_bundle = false
                      if current_prod.type == 'Bundle'
                        assign is_bundle = true
                      endif

                      # Initial selling plan
                      assign init_sub_plan_id = ''
                      if current_variant != blank and current_variant.selling_plan_allocations.size > 0
                        assign init_sub_plan_id = current_variant.selling_plan_allocations[0].selling_plan.id
                      elsif current_prod.selling_plan_groups.size > 0
                        assign init_sub_plan_id = current_prod.selling_plan_groups[0].selling_plans[0].id
                      endif

                      # Initial locked quantity for subscription (2 for simple product, 1 for bundle)
                      assign init_sub_qty = 2
                      if is_bundle
                        assign init_sub_qty = 1
                      endif
                    -%}

                    {%- assign product_form_id = 'ww-product-form-' | append: block.id -%}
                    <product-form-component
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ current_prod.id }}"
                      data-product-url="{{ current_prod.url }}"
                      on:submit="/handleSubmit"
                      data-quantity-default="1"
                    >
                      <div
                        class="visually-hidden"
                        aria-live="assertive"
                        role="status"
                        aria-atomic="true"
                        ref="liveRegion"
                      ></div>
                      {%- form 'product',
                        current_prod,
                        id: product_form_id,
                        class: 'ww-product-form ww-product-form--v2',
                        data-type: 'add-to-cart-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          ref="variantId"
                          value="{{ initial_variant_id }}"
                          class="ww-variant-id-input"
                        >
                        <input
                          type="hidden"
                          name="selling_plan"
                          value="{{ init_sub_plan_id }}"
                          class="ww-selling-plan-input"
                          {% if init_sub_plan_id == blank %}
                            disabled
                          {% endif %}
                        >
                        <input type="hidden" name="quantity" value="{{ init_sub_qty }}" class="ww-qty-input">

                        {% render 'ww-product-purchase-options-v2', current_prod: current_prod, block: block %}

                        <span class="product-form-text__error hidden" ref="addToCartTextError">
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </span>

                        <div class="ww-buy-row">
                          <div class="ww-qty" style="display: none;">
                            <button type="button" class="ww-qty-btn-minus" aria-label="Decrease quantity">−</button>
                            <span class="v">1</span>
                            <button type="button" class="ww-qty-btn-plus" aria-label="Increase quantity">+</button>
                          </div>

                          {%- assign add_to_cart_text = 'products.product.add_to_cart' | t -%}
                          {%- if current_prod.available == false -%}
                            {%- assign add_to_cart_text = 'products.product.sold_out' | t -%}
                          {%- endif -%}

                          {% render 'add-to-cart-button',
                            product: current_prod,
                            can_add_to_cart: current_prod.available,
                            show_icon: true,
                            add_to_cart_text: add_to_cart_text,
                            class: 'add-to-cart-button ww-add'
                          %}
                        </div>
                      {%- endform -%}
                    </product-form-component>

                    <div class="ww-buy-trust">
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M9 12l2 2 4-4"></path>
                          <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        Free shipping $50+
                      </span>
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
                          <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        3rd-party tested
                      </span>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>

            <div class="ww-info">
              {%- assign found_our_tab = false -%}
              {%- for sub_block in section.blocks -%}
                {%- if sub_block.id == block.id -%}
                  {%- assign found_our_tab = true -%}
                {%- elsif sub_block.type == 'product_tab' -%}
                  {%- if found_our_tab -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if found_our_tab and sub_block.type == 'accordion' -%}
                  {%- assign acc_title = sub_block.settings.title | default: 'Ingredients' -%}
                  {%- assign acc_type = sub_block.settings.content_type -%}
                  {%- assign acc_content = '' -%}

                  {%- if acc_type == 'custom' -%}
                    {%- assign acc_content = sub_block.settings.content -%}
                  {%- elsif acc_type == 'ingredients' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-ingredients', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'bundle' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-bundle', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'supplement_facts' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-supplement-facts', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'capsule_size' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-capsule', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- endif -%}

                  {%- assign show_acc = false -%}
                  {%- if acc_content != blank -%}
                    {%- assign show_acc = true -%}
                  {%- endif -%}

                  {%- if show_acc -%}
                    <details class="ww-acc" {{ sub_block.shopify_attributes }}>
                      <summary>
                        <span class="ww-acc-plus">+</span>
                        <span class="ww-acc-t">{{ acc_title | escape }}</span>
                        {%- if sub_block.settings.items_count != blank -%}
                          <span class="ww-acc-c">{{ sub_block.settings.items_count | escape }}</span>
                        {%- elsif acc_type == 'ingredients' -%}
                          {%- assign ingredients_list = current_prod.metafields.custom.ingredients.value -%}
                          {%- if ingredients_list != blank -%}
                            <span class="ww-acc-c">{{ ingredients_list.size }} items</span>
                          {%- endif -%}
                        {%- elsif acc_type == 'bundle' -%}
                          {%- assign bundle_products = blank -%}
                          {%- assign bundle_rules = shop.metafields.appstle_bundles.bundle_rules.value -%}
                          {%- if bundle_rules != blank -%}
                            {%- for rule in bundle_rules -%}
                              {%- if rule.bundleProductId == current_prod.id or rule.productId == current_prod.id -%}
                                {%- assign bundle_products = rule.products -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {%- if bundle_products != blank -%}
                            {%- capture products_str -%}{{ bundle_products }}{%- endcapture -%}
                            {%- assign parts = products_str | split: '"productHandle":"' -%}
                            {%- assign parts_size = parts.size | minus: 1 -%}
                            {%- if parts_size > 0 -%}
                              <span class="ww-acc-c">{{ parts_size }} products</span>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      </summary>
                      <div class="ww-acc-body">
                        {{ acc_content }}
                      </div>
                    </details>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if section.settings.trust_heading != blank -%}
                <div class="ww-info-trust">
                  <div class="ww-info-trust-h">{{ section.settings.trust_heading | escape }}</div>
                  <div class="ww-info-trust-grid">
                    {%- if section.settings.trust_item_1_title != blank
                      or section.settings.trust_item_1_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_1_title != blank -%}
                          <h4>{{ section.settings.trust_item_1_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_1_text != blank -%}
                          <p>{{ section.settings.trust_item_1_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if section.settings.trust_item_2_title != blank
                      or section.settings.trust_item_2_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_2_title != blank -%}
                          <h4>{{ section.settings.trust_item_2_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_2_text != blank -%}
                          <p>{{ section.settings.trust_item_2_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <!-- Close .ww-info -->
          </div>
          <!-- Close .ww-panel -->
        {%- endif -%}
      {%- endfor -%}
      </div>
      <!-- Close .ww-shop__desktop -->

      {%- comment -%}
        ============================================================
        Mobile & Tablet View: Swipe Carousel (< 1024px)
        ============================================================
      {%- endcomment -%}
      <div class="ww-shop__mobile">
        <div class="ww-mob-carousel" id="ww-mob-carousel-{{ section.id }}">
          <div class="ww-mob-carousel__track" role="region" aria-label="Product Carousel">
            {%- assign mob_slide_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_tab' -%}
                {%- assign current_prod = block.settings.product -%}
                {%- if current_prod == blank -%}
                  {%- assign handle_guess = block.settings.title | handleize -%}
                  {%- assign current_prod = all_products[handle_guess] -%}
                  {%- if current_prod == blank and collections.all.products.size > 0 -%}
                    {%- assign prod_idx = forloop.index0 | modulo: collections.all.products.size -%}
                    {%- assign current_prod = collections.all.products[prod_idx] -%}
                  {%- endif -%}
                {%- endif -%}

                {%- assign title = block.settings.title | default: current_prod.title -%}
                {%- assign subtitle = block.settings.subtitle
                  | default: current_prod.metafields.custom.subtitle.value
                  | default: current_prod.metafields.custom.subtitle
                -%}
                {%- assign desc = block.settings.description | default: current_prod.description -%}

                {%- assign current_variant = current_prod.selected_or_first_available_variant -%}
                {%- assign is_bundle = false -%}
                {%- if current_prod.type == 'Bundle' or current_prod.handle == 'the-travel-duo' -%}
                  {%- assign is_bundle = true -%}
                {%- endif -%}

                {%- assign base_servings = current_prod.metafields.custom.servings.value | default: current_prod.metafields.custom.servings | default: 15 -%}
                {%- if is_bundle -%}
                  {%- assign base_servings = 30 -%}
                {%- endif -%}

                {%- assign card_price = current_variant.price | money -%}
                {%- assign card_serving_rate = current_variant.price | times: 1.0 | divided_by: base_servings | floor | money -%}

                {%- comment -%} Parse format type and ingredient badge {%- endcomment -%}
                {%- assign format_type = 'Capsules' -%}
                {%- assign ingredient_badge = 'GINGER' -%}

                {%- if subtitle contains '·' -%}
                  {%- assign sub_parts = subtitle | split: '·' -%}
                  {%- assign format_type = sub_parts[0] | strip -%}
                  {%- assign ingredient_badge = sub_parts[1] | strip | upcase -%}
                {%- elsif subtitle != blank -%}
                  {%- assign format_type = subtitle -%}
                  {%- assign ingredient_badge = subtitle | upcase -%}
                {%- endif -%}

                {%- comment -%} Background color per product matching brand aesthetic {%- endcomment -%}
                {%- assign prod_handle = current_prod.handle | default: title | handleize -%}
                {%- if prod_handle contains 'immune' -%}
                  {%- assign bg_color = '#E9B36B' -%}
                  {%- if ingredient_badge == blank or ingredient_badge == 'GINGER' -%}
                    {%- assign ingredient_badge = 'VITAMIN C' -%}
                  {%- endif -%}
                {%- elsif prod_handle contains 'duo' or is_bundle -%}
                  {%- assign bg_color = '#B89B7B' -%}
                  {%- if ingredient_badge == blank or ingredient_badge == 'GINGER' -%}
                    {%- assign ingredient_badge = 'THE DUO' -%}
                  {%- endif -%}
                {%- else -%}
                  {%- assign bg_color = '#94A671' -%}
                  {%- if ingredient_badge == blank -%}
                    {%- assign ingredient_badge = 'GINGER' -%}
                  {%- endif -%}
                {%- endif -%}

                <div
                  class="ww-mob-carousel__slide"
                  data-slide-index="{{ mob_slide_count }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="ww-mob-card">
                    <a
                      href="{{ current_prod.url | default: '#' }}"
                      class="ww-mob-card__media"
                      style="background-color: {{ bg_color }};"
                      aria-label="View {{ title | escape }}"
                    >
                      {%- if ingredient_badge != blank -%}
                        <span class="ww-mob-card__pill">{{ ingredient_badge }}</span>
                      {%- endif -%}

                      {%- if current_prod.featured_image != blank -%}
                        {{
                          current_prod.featured_image
                          | image_url: width: 700
                          | image_tag:
                            class: 'ww-mob-card__img',
                            loading: 'lazy',
                            decoding: 'async',
                            alt: title
                        }}
                      {%- else -%}
                        <div class="ww-mob-card__placeholder">
                          <span class="ww-mob-card__logo">wanderWell</span>
                        </div>
                      {%- endif -%}
                    </a>

                    <div class="ww-mob-card__body">
                      <div class="ww-mob-card__eyebrow">
                        {{ title | upcase }} · {{ format_type | upcase }}
                      </div>
                      <a href="{{ current_prod.url | default: '#' }}" class="ww-mob-card__title">
                        {{ title | escape }}
                      </a>
                      {%- if desc != blank -%}
                        <p class="ww-mob-card__desc">{{ desc | escape }}</p>
                      {%- endif -%}

                      <div class="ww-mob-card__price-row">
                        <span class="ww-mob-card__price">{{ card_price }}</span>
                        <span class="ww-mob-card__serving-rate">{{ card_serving_rate }}/serving</span>
                      </div>

                      <a href="{{ current_prod.url | default: '#' }}" class="ww-mob-card__cta">
                        View Detail
                      </a>
                    </div>
                  </div>
                </div>
                {%- assign mob_slide_count = mob_slide_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if mob_slide_count > 1 -%}
            <div class="ww-mob-carousel__dots" role="tablist" aria-label="Product carousel navigation">
              {%- for i in (1..mob_slide_count) -%}
                <button
                  type="button"
                  class="ww-mob-carousel__dot {% if forloop.first %}is-active{% endif %}"
                  data-slide-index="{{ forloop.index0 }}"
                  aria-label="Go to product slide {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      <!-- Close .ww-shop__mobile -->
    </div>
  </div>
</section>

{%- if section.settings.enable_sticky_add_to_cart != false -%}
  <div class="ww-sticky-bar" id="ww-sticky-bar" data-section-id="{{ section.id }}" data-active="false">
    <div class="ww-sticky-bar__inner container">
      <div class="ww-sticky-bar__info">
        <div class="ww-sticky-bar__title-row">
          <h4 class="ww-sticky-bar__title"></h4>
          <button
            type="button"
            class="ww-sticky-bar__product-toggle"
            aria-label="Switch product"
            title="Switch product"
          >
            <svg
              class="ww-sticky-bar__toggle-icon"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 16V4M7 4L3 8M7 4L11 8M17 8V20M17 20L21 16M17 20L13 16"></path>
            </svg>
            <span class="ww-sticky-bar__toggle-text">Switch</span>
          </button>
        </div>
        <div class="ww-sticky-bar__option-trigger">
