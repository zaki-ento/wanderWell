{% comment %}
  Section: WW Problem (The Problem / Reality of Travel)
  Description: Custom interactive scroll-driven route map section showing travel statement blocks.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.layout_width == 'full' -%}
    .section-{{ section.id }} .container {
      max-width: none !important;
      width: 100%;
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}

  /* Dynamic SVG map styling */
  #wwWorld-{{ section.id }} {
    position: absolute;
    left: -8%;
    top: 4%;
    width: 116%;
    height: 92%;
    opacity: .5;
    will-change: transform;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12%), radial-gradient(ellipse 60% 55% at 100% 100%, transparent 0%, #000 70%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0, #000 12%), radial-gradient(ellipse 60% 55% at 100% 100%, transparent 0%, #000 70%);
    mask-composite: intersect;
  }

  #wwWorld-{{ section.id }} path {
    fill: rgba(255, 255, 255, .045);
    stroke: rgba(255, 255, 255, .17);
    stroke-width: .9;
    vector-effect: non-scaling-stroke;
    shape-rendering: optimizeSpeed;
  }
{%- endstyle -%}

<div class="problem section-{{ section.id }} ww-problem-section" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="container max-w-breakpoint-xl">
    <div class="problem-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ww-route" id="wwRoute-{{ section.id }}">
    <div class="ww-route-track" id="wwRouteTrack-{{ section.id }}">
      <div class="ww-route-sticky">
        <div class="ww-route-bg" aria-hidden="true">
          <div class="ww-route-bg-grid"></div>
          <svg id="wwWorld-{{ section.id }}" preserveAspectRatio="xMidYMid slice"></svg>
          <div class="ww-route-bg-bloom"></div>
        </div>
        <div class="ww-route-map" aria-hidden="true">
          <svg id="wwRouteSvg-{{ section.id }}" preserveAspectRatio="none">
            <defs>
              <mask id="wwRouteMask-{{ section.id }}">
                <path id="wwRouteMaskPath-{{ section.id }}" fill="none" stroke="#fff" stroke-width="34" stroke-linecap="round"></path>
              </mask>
            </defs>
            <path id="wwRouteGhost-{{ section.id }}" fill="none" stroke="var(--white)" stroke-opacity=".3" stroke-width="5" stroke-linecap="round" stroke-dasharray="0.1 16"></path>
            <g mask="url(#wwRouteMask-{{ section.id }})">
              <path id="wwRoutePath-{{ section.id }}" fill="none" stroke="var(--white)" stroke-width="6.5" stroke-linecap="round" stroke-dasharray="0.1 16"></path>
            </g>
            <g id="wwRouteStops-{{ section.id }}"></g>
            <g id="wwRoutePin-{{ section.id }}" class="ww-route-pin" opacity="0">
              <ellipse cx="0" cy="4" rx="13" ry="4" fill="#B8410F" opacity=".35"></ellipse>
              <path d="M0 0 C -10 -14 -16 -22 -16 -30 A 16 16 0 1 1 16 -30 C 16 -22 10 -14 0 0 Z" fill="var(--cream)"></path>
              <circle cx="0" cy="-31" r="6" fill="var(--orange)"></circle>
            </g>
          </svg>
        </div>
        <div class="ww-route-lines">
          {%- for block in section.blocks -%}
            {%- if block.type == 'story_step' -%}
              <div class="ww-route-line" {{ block.shopify_attributes }}>
                <p>{{ block.settings.title | escape }}</p>
                <small>{{ block.settings.subtitle | escape }}</small>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="problem-outro">
    <div class="container max-w-breakpoint-xl">
      <div class="problem-bridge">
        {%- if section.settings.outro_heading != blank -%}
          <p class="bridge-hook">{{ section.settings.outro_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.outro_subheading != blank -%}
          <p class="bridge-body">{{ section.settings.outro_subheading | escape }}</p>
        {%- endif -%}
        
        <ul class="bridge-chips">
          {%- for block in section.blocks -%}
            {%- if block.type == 'outro_pill' -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.outro_button_label != blank -%}
          <a href="{{ section.settings.outro_button_link | default: '#products' }}" class="bridge-cta">
            {{ section.settings.outro_button_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<script src="{{ 'ww-problem.js' | asset_url }}" defer></script>

{% stylesheet %}
  .problem {
    background: var(--orange);
    --problem-ink: #431E0C;
  }
  
  .problem .section-label { 
    color: var(--problem-ink); 
    font-weight: 700; 
  }
  
  .problem .section-title { 
    color: var(--white); 
    font-family: var(--font-tertiary);
    font-weight: 600; 
    font-size: 3.6rem;
    margin: 0px 0px 16px;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-wrap: balance;
  }
  
  .problem .section-subtitle { 
    color: rgba(255,255,255,0.96); 
    font-size: clamp(1rem, 2vw, 1.22rem); 
    font-weight: 500; 
    max-width: 630px; 
  }
  
  .problem-header {
    text-align: center;
    margin-bottom: 44px;
  }
  
  .problem-header .section-subtitle {
    margin: 0 auto;
  }

  .ww-route {
    position: relative;
  }
  
  .ww-route-track {
    position: relative;
    height: 230vh;
  }
  
  .ww-route-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  
  .ww-route-map {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  
  .ww-route-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  
  .ww-route-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(to bottom, var(--orange) 0%, rgba(232,99,43,0) 14%);
    pointer-events: none;
  }
  
  .ww-route-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(ellipse 60% 55% at 100% 100%, var(--orange) 0%, rgba(232,99,43,0) 70%);
    pointer-events: none;
  }
  
  .ww-route-bg-grid {
    position: absolute;
    inset: -8%;
    will-change: transform;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%), radial-gradient(ellipse 60% 55% at 100% 100%, transparent 0%, #000 70%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0, #000 16%), radial-gradient(ellipse 60% 55% at 100% 100%, transparent 0%, #000 70%);
    mask-composite: intersect;
    background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 74px), repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 74px);
  }
  
  .ww-route-bg-grid::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,.5) .5px, transparent .6px), radial-gradient(circle at 70% 80%, rgba(0,0,0,.5) .5px, transparent .6px);
    background-size: 7px 7px, 9px 9px;
    opacity: .07;
  }
  
  .ww-route-bg-bloom {
    position: absolute;
    inset: -10%;
    will-change: transform;
    background: radial-gradient(60% 50% at 18% 16%, rgba(255,255,255,.09), rgba(255,255,255,0) 70%), radial-gradient(55% 45% at 80% 78%, rgba(120,38,8,.18), rgba(120,38,8,0) 72%);
  }
  
  .ww-route-map svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  
  .ww-route-pin {
    transition: opacity .3s ease;
  }
  
  .ww-route-stop {
    transition: opacity .45s ease, r .45s cubic-bezier(.2, 1.4, .3, 1);
  }
  
  .ww-route-lines {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    padding: 0;
  }
  
  .ww-route-line {
    position: absolute;
    top: 0;
    max-width: 415px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .5s ease, transform .6s cubic-bezier(.2, .9, .2, 1);
    pointer-events: none;
  }
  
  .ww-route-line small {
    max-width: 100%;
  }
  
  .ww-route-line.on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  
  .ww-route-line.past {
    opacity: 0;
    transform: translateY(-20px);
  }
  
  .ww-route-line p {
    font-family: var(--font-primary);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.5vw, 2.35rem);
    line-height: 1.22;
    letter-spacing: -.01em;
    color: var(--white);
    text-wrap: pretty;
    margin: 0;
  }
  
  .ww-route-line em {
    font-style: italic;
    color: var(--cream);
  }
  
  .ww-route-line small {
    display: block;
    margin-top: 16px;
    font-family: var(--font-tertiary);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255,255,255,.72);
    line-height: 1.7;
    max-width: 40ch;
  }
  
  @media (max-width:900px) {
    .ww-route-track {
      height: 210vh;
    }
    .ww-route-line p {
      font-size: 1.45rem;
    }
  }
  
  .ww-route.no-pin .ww-route-track {
    height: auto;
  }
  
  .ww-route.no-pin .ww-route-sticky {
    position: static;
    height: auto;
    min-height: 0;
    flex-direction: column;
    padding: 30px 0;
  }
  
  .ww-route.no-pin .ww-route-map {
    position: relative;
    height: 280px;
    width: 100%;
  }
  
  .ww-route.no-pin .ww-route-lines {
    position: static;
    padding: 24px;
    display: block;
    min-height: 0;
  }
  
  .ww-route.no-pin .ww-route-line {
    position: static;
    opacity: 1;
    transform: none;
    margin-bottom: 34px;
    max-width: none;
    width: auto !important;
    text-align: left !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
  }
  
  @media (prefers-reduced-motion:reduce) {
    .ww-route-line {
      transition: none;
    }
  }
  
  .problem-outro {
    position: relative;
    z-index: 2;
  }
  
  .problem-bridge {
    margin-top: 20px;
    margin-bottom: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 12px 32px 24px;
  }
  
  .bridge-hook {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    line-height: 1.08;
    color: var(--white);
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0;
  }
  
  .bridge-hook em {
    color: var(--problem-ink);
    font-style: italic;
    font-weight: 700;
  }
  
  .bridge-body {
    font-size: clamp(1rem, 2vw, 1.18rem);
    font-weight: 400;
    color: #fff;
    max-width: 60ch;
    line-height: 1.6;
    letter-spacing: 0.01em;
    margin: 0;
  }
  
  .bridge-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: center;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }
  
  .bridge-chips li {
    font-family: var(--font-tertiary);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #fff;
    border: 1px solid rgba(255,255,255,.24);
    background: rgba(255,255,255,.06);
    border-radius: 999px;
    padding: 8px 15px;
  }
  
  @media (max-width: 768px) {
    .problem-bridge .bridge-chips li {
      font-size: 0.85rem;
    }
  }
  
  .bridge-cta {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--white);
    color: var(--orange);
    border-radius: 8px;
    font-family: var(--font-tertiary);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    border: none;
    transition: background 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }
  
  .bridge-cta:hover {
    background: var(--cream);
    transform: translateY(-2px);
  }
  
  .bridge-cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  
  .bridge-cta:hover svg {
    transform: translateX(3px);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "WW Problem",
  "tag": "section",
  "class": "ww-section-problem",
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You didn't come here to stick to a routine"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "New places, later nights, food you can't pronounce. Your body notices. That's where we come in."
    },
    {
      "type": "header",
      "content": "Outro Content"
    },
    {
      "type": "text",
      "id": "outro_heading",
      "label": "Outro Heading",
      "default": "Say yes to the second gelato."
    },
    {
      "type": "text",
      "id": "outro_subheading",
      "label": "Outro Subheading",
      "default": "Built for the version of the trip you actually get to enjoy."
    },
    {
      "type": "text",
      "id": "outro_button_label",
      "label": "Outro Button Label",
      "default": "Explore the products"
    },
    {
      "type": "url",
      "id": "outro_button_link",
      "label": "Outro Button Link"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Width",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "story_step",
      "name": "Story Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Somewhere between leaving home..."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Step Subtitle",
          "default": "New surroundings, new pace..."
        }
      ]
    },
    {
      "type": "outro_pill",
      "name": "Autro Pills",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Pill Text",
          "default": "Individually sacheted"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Problem",
      "blocks": [
        {
          "type": "story_step",
          "settings": {
            "title": "Somewhere between leaving home and the first night somewhere else, something shifts.",
            "subtitle": "New surroundings, new pace, new normal, for a while"
          }
        },
        {
          "type": "story_step",
          "settings": {
            "title": "You planned the trip. Your body's still catching up.",
            "subtitle": "Different food, different sleep, a different clock"
          }
        },
        {
          "type": "story_step",
          "settings": {
            "title": "So it asks for a little more than usual.",
            "subtitle": "More water. More rest. More support."
          }
        },
        {
          "type": "story_step",
          "settings": {
            "title": "That's what we're here for.",
            "subtitle": "Wherever the journey takes you"
          }
        },
        {
          "type": "outro_pill",
          "settings": {
            "text": "Individually sacheted"
          }
        },
        {
          "type": "outro_pill",
          "settings": {
            "text": "Doses that make sense"
          }
        },
        {
          "type": "outro_pill",
          "settings": {
            "text": "Ingredients you recognize"
          }
        },
        {
          "type": "outro_pill",
          "settings": {
            "text": "Third-party tested"
          }
        }
      ]
    }
  ]
}
{% endschema %}
