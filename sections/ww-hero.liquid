{% comment %}
  Section: WW Hero
  Description: Custom hero section with background video backdrop, supergraphic logo overlay, and animated ticker strip.
{% endcomment %}

<div class="ww-hero section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="ww-hero__supergraphic">
    {%- if section.settings.supergraphic_image != blank -%}
      {{ section.settings.supergraphic_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.supergraphic_image.alt }}
    {%- elsif settings.logo_inverse != blank -%}
      {{ settings.logo_inverse | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'wanderWell supergraphic' }}
    {%- endif -%}
  </div>

  <div class="ww-hero__inner container">
    <div class="ww-hero__content">
      <div class="ww-hero__text">
        {%- if section.settings.badge != blank -%}
          <div class="ww-hero__badge">{{ section.settings.badge | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ww-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ww-hero__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <div class="ww-hero__buy">
            <div class="ww-hero__cta-stack">
              <div class="ww-hero__cta-row">
                <a href="{{ section.settings.button_link | default: '#products' }}" class="btn-cta btn-cta--wide" aria-label="{{ section.settings.button_label | escape }}">
                  <span class="cta-label cta-label--single">{{ section.settings.button_label | escape }}</span>
                  <span class="cta-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14"></path>
                      <path d="M13 5l7 7-7 7"></path>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- HERO VIDEO backdrop -->
  {%- if section.settings.video_backdrop != blank -%}
    <div class="ww-herovid">
      <div class="ww-herovid-poster" aria-hidden="true">
        {%- if section.settings.image_backdrop != blank -%}
          {{ section.settings.image_backdrop | image_url: width: 1920 | image_tag: loading: 'eager', alt: 'Hero Video Background Poster' }}
        {%- endif -%}
      </div>
      {{ section.settings.video_backdrop | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'ww-herovid-el', preload: 'metadata', aria-label: 'wanderWell hero film' }}
      <button type="button" class="ww-herovid-toggle" aria-pressed="false" aria-label="Pause video">
        <span class="ww-herovid-icon" aria-hidden="true"></span>
      </button>
    </div>
  {%- elsif section.settings.image_backdrop != blank -%}
    <div class="ww-herovid">
      <div class="ww-herovid-poster">
        {{ section.settings.image_backdrop | image_url: width: 1920 | image_tag: loading: 'eager', alt: 'Hero Background Image' }}
      </div>
    </div>
  {%- endif -%}
</div>

<!-- MADE FOR TICKER -->
{%- if section.settings.show_ticker -%}
  <div class="made-for-strip">
    <div class="made-for-label">{{ section.settings.ticker_label | default: 'Made for' | escape }}</div>
    <div style="overflow:hidden; flex:1; min-width:0; display: flex; align-items: center;">
      <div class="made-for-track" id="made-for-track-{{ section.id }}">
        {%- liquid
          assign ticker_items_default = 'travelers,van-lifers,voyagers,sightseers,backsacheters,tourists,adventurers,globe-trotters,commuters,vacationers,daytrippers,wanderers' | split: ','
          
          # Gather items from blocks or fall back to default
          assign has_blocks = false
          for block in section.blocks
            if block.type == 'ticker_item' and block.settings.text != blank
              assign has_blocks = true
            endif
          endfor
        -%}
        
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'ticker_item' and block.settings.text != blank -%}
              <span class="made-for-item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              <span class="made-for-item made-for-dot" aria-hidden="true">·</span>
            {%- endif -%}
          {%- endfor -%}
          {%- comment -%} Duplicate items once for seamless loop {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'ticker_item' and block.settings.text != blank -%}
              <span class="made-for-item">{{ block.settings.text | escape }}</span>
              <span class="made-for-item made-for-dot" aria-hidden="true">·</span>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for item in ticker_items_default -%}
            <span class="made-for-item">{{ item }}</span>
            <span class="made-for-item made-for-dot" aria-hidden="true">·</span>
          {%- endfor -%}
          {%- for item in ticker_items_default -%}
            <span class="made-for-item">{{ item }}</span>
            <span class="made-for-item made-for-dot" aria-hidden="true">·</span>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    {%- comment -%} Add pause button for accessibility (WCAG 2.2.2 compliance) {%- endcomment -%}
    <button type="button" class="ticker-pause" aria-label="Pause scrolling text" onclick="toggleTicker(this, 'made-for-track-{{ section.id }}')">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
        <rect x="1" y="0" width="3" height="10"/>
        <rect x="6" y="0" width="3" height="10"/>
      </svg>
    </button>
  </div>
{%- endif -%}

{% stylesheet %}
  .ww-hero {
    padding: 160px 0 100px;
    background: linear-gradient(135deg, #F5C842 0%, #F0845A 40%, #E8632B 100%);
    position: relative;
    overflow: hidden;
  }

  .ww-hero__supergraphic {
    position: absolute;
    bottom: -20px;
    left: -10px;
    right: -10px;
    user-select: none;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.12;
    z-index: 1;
  }

  .ww-hero__supergraphic img,
  .ww-hero__supergraphic svg {
    width: 100%;
    display: block;
    pointer-events: none;
  }

  .ww-hero__content {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ww-hero__text {
    position: relative;
    z-index: 2;
  }

  .ww-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.35);
    padding: 6px 16px;
    border-radius: 50px;
    font-family: var(--font-tertiary);
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 24px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ww-hero__heading {
    font-family: var(--font-tertiary);
    font-weight: 500;
    font-size: 50px;
    line-height: 0.9;
    color: #fff;
    margin-bottom: 24px;
    letter-spacing: -0.04em;
    max-width: 16ch;
  }

  .ww-hero__heading em strong {
    font-size: 60px;
    font-style: italic;
    font-weight: 700;
  }

  .ww-hero__heading em {
    font-style: italic;
    color: rgba(255,255,255,0.85);
  }

  .ww-hero__sub {
    font-size: 1.1rem;
    font-weight: 400;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 480px;
    letter-spacing: -0.02em;
  }

  .ww-hero__buy {
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ww-hero__cta-stack {
    display: flex;
    flex-direction: column;
  }

  .ww-hero__cta-row {
    display: flex;
  }

  /* Video Background styling (from v2.css) */
  .ww-herovid {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: linear-gradient(150deg,#FFDCA4,#F8AC72 60%,#F2936C);
  }
  .ww-herovid-poster {
    position: absolute;
    inset: 0;
  }
  .ww-herovid-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ww-herovid-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }
  .ww-herovid-el[src] {
    display: block;
  }
  .ww-herovid::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(100deg,rgba(138,54,20,.8) 0%,rgba(150,64,26,.58) 42%,rgba(160,76,32,.28) 72%,rgba(150,64,26,.44) 100%);
  }
  .ww-herovid-toggle {
    position: absolute;
    right: clamp(16px, 3vw, 32px);
    bottom: clamp(16px, 3vw, 32px);
    z-index: 4;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.55);
    background: rgba(30,12,4,.34);
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
    padding: 0;
  }
  .ww-herovid-toggle:hover {
    background: rgba(30,12,4,.55);
    transform: scale(1.05);
  }
  .ww-herovid-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .ww-herovid-icon {
    width: 12px;
    height: 14px;
    border-left: 3.5px solid #fff;
    border-right: 3.5px solid #fff;
    display: inline-block;
    box-sizing: border-box;
  }
  .ww-herovid-toggle[aria-pressed="true"] .ww-herovid-icon {
    width: 0;
    height: 0;
    border-left: 12px solid #fff;
    border-right: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-left: 3px;
  }

  /* Made For Ticker styling (from styles.css) */
  .made-for-strip {
    background: linear-gradient(90deg, var(--orange-dark), var(--orange));
    padding: 0;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .made-for-label {
    padding: 0 24px 0 40px;
    height: 52px;
    display: flex;
    align-items: center;
    font-family: var(--font-tertiary);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(44,44,44,0.92);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .made-for-track {
    display: flex;
    align-items: center;
    height: 52px;
    animation: mfTicker 22s linear infinite;
    white-space: nowrap;
  }
  .made-for-item {
    display: inline-flex;
    align-items: center;
    height: 52px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
    margin-right: 0;
    flex-shrink: 0;
    line-height: 1;
  }
  .made-for-dot {
    font-size: 0;
    width: 6px;
    height: 6px;
    background: var(--charcoal);
    border-radius: 50%;
    flex-shrink: 0;
    margin: 0 22px;
  }

  @keyframes mfTicker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .ww-hero {
      padding: 120px 0 60px;
    }
    .ww-hero__content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .ww-hero__heading {
      font-size: 2.8rem;
    }
    .ww-hero__heading em strong {
      font-size: 3.2rem;
    }
  }

  @media (max-width: 640px) {
    .ww-hero {
      padding: 100px 0 50px;
    }
    .ww-hero__heading {
      font-size: 2.4rem;
    }
    .ww-hero__heading em strong {
      font-size: 2.8rem;
    }
    .ww-herovid::after {
      background: linear-gradient(to bottom, rgba(150,60,24,.5), rgba(138,54,20,.84));
    }
    .ww-hero__badge {
      font-size: 0.85rem;
    }
    .made-for-item {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .made-for-track {
      animation-play-state: paused;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Ticker play/pause control
  window.toggleTicker = function(btn, trackId) {
    var track = document.getElementById(trackId);
    if (!track) return;
    var isPaused = track.style.animationPlayState === 'paused';
    track.style.animationPlayState = isPaused ? 'running' : 'paused';
    btn.setAttribute('aria-label', isPaused ? 'Pause scrolling text' : 'Resume scrolling text');
    btn.innerHTML = isPaused
      ? '<svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><rect x="1" y="0" width="3" height="10"/><rect x="6" y="0" width="3" height="10"/></svg>'
      : '<svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><polygon points="1,0 9,5 1,10"/></svg>';
  };

  // Hero video controls
  document.addEventListener('DOMContentLoaded', function() {
    var wrap = document.querySelector('.ww-herovid');
    if (!wrap) return;
    var vid = wrap.querySelector('.ww-herovid-el');
    var btn = wrap.querySelector('.ww-herovid-toggle');
    if (!vid || !btn) return;
    
    var RM = window.matchMedia('(prefers-reduced-motion: reduce)');
    var userPaused = RM.matches;
    
    function sync() {
      var paused = vid.paused;
      btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
      btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    }
    
    btn.addEventListener('click', function() {
      if (vid.paused) {
        userPaused = false;
        vid.play().catch(function(){});
      } else {
        userPaused = true;
        vid.pause();
      }
      sync();
    });
    
    vid.addEventListener('play', sync);
    vid.addEventListener('pause', sync);
    
    if (userPaused) {
      vid.pause();
    }
    
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            if (!userPaused) vid.play().catch(function(){});
          } else {
            vid.pause();
          }
        });
      }, { threshold: 0.1 }).observe(wrap);
    }
    
    sync();
  });
{% endjavascript %}

{% schema %}
{
  "name": "WW Hero",
  "tag": "section",
  "class": "ww-section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media Backdrops"
    },
    {
      "type": "video",
      "id": "video_backdrop",
      "label": "Video backdrop"
    },
    {
      "type": "image_picker",
      "id": "image_backdrop",
      "label": "Fallback image / Poster frame"
    },
    {
      "type": "image_picker",
      "id": "supergraphic_image",
      "label": "Supergraphic overlay"
    },
    {
      "type": "header",
      "content": "Ticker Settings"
    },
    {
      "type": "checkbox",
