{% comment %}
  Section: WW Footer Section / Faster Routes Block
  Description: Custom dynamic section displaying support routes, direct contacts, and policy notices.
{% endcomment %}

<div id="ww-footer-section" class="ww-footer-section section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="container max-w-breakpoint-md">
    <div class="page-block ww-footer-section__block">
      {%- if section.settings.heading != blank -%}
        <h2 class="ww-footer-section__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.content != blank -%}
        <div class="page-block__content ww-footer-section__content">
          {{ section.settings.content }}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <div class="page-note ww-footer-section__note">
          {{ section.settings.note }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ww-footer-section {
    padding: 0 0 clamp(48px, 6vw, 80px);
    background-color: var(--white, #ffffff);
  }

  .ww-footer-section .page-block {
    margin-bottom: 0;
  }

  .ww-footer-section .page-block h2 {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--charcoal, #2C2C2C);
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }

  .ww-footer-section .page-block p,
  .ww-footer-section .page-block__content p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--charcoal-light, #5A5A5A);
    margin: 0 0 14px;
    max-width: 62ch;
  }

  .ww-footer-section .page-block a,
  .ww-footer-section .page-block__content a {
    color: var(--charcoal, #2C2C2C);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .ww-footer-section .page-block a:hover,
  .ww-footer-section .page-block__content a:hover {
    color: var(--orange, #E8632B);
  }

  .ww-footer-section .page-note {
    background: var(--cream, #FAF7F2);
    border-radius: 16px;
    padding: 22px 24px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--charcoal-light, #5A5A5A);
    max-width: 62ch;
    margin-top: 20px;
  }

  .ww-footer-section .page-note p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .ww-footer-section .page-note strong {
    color: var(--charcoal, #2C2C2C);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WW Footer Section",
  "tag": "section",
  "class": "ww-section-footer-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Faster routes"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p><strong>Order status:</strong> <a href=\"/pages/order-tracking\">track it here</a> — that answers most \"where is it\" questions instantly.<br><strong>Returns:</strong> see the <a href=\"/pages/returns-exchanges\">30-day guarantee</a>.<br><strong>Email directly:</strong> <a href=\"mailto:care@shopwanderwell.co\">care@shopwanderwell.co</a></p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Notice / Note",
      "default": "<p>We can't give medical advice. If you're pregnant, nursing, or taking medication, check with your doctor before starting any supplement — including ours.</p>"
    }
  ],
  "presets": [
    {
      "name": "WW Footer Section"
    }
  ]
}
{% endschema %}
