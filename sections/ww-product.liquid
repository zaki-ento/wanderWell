{% comment %}
  Section: WW Products Hub
  Description: Custom interactive tabbed product interface for up to 3 products.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.layout_width == 'full' -%}
    .section-{{ section.id }} .container {
      max-width: none !important;
      width: 100%;
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}
{%- endstyle -%}

{%- assign p1 = section.settings.product_1 -%}
{%- assign p2 = section.settings.product_2 -%}
{%- assign p3 = section.settings.product_3 -%}

<section class="products section-{{ section.id }}" id="products" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="products-header">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}
      
      <div class="products-badges">
        {%- if section.settings.badge_1_text != blank -%}
          <span class="product-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21v-9"></path>
              <path d="M12 12c0-4 -3-6-7-6 0 4 3 6 7 6z"></path>
              <path d="M12 12c0-5 3-8 8-8 0 5-3 8-8 8z"></path>
            </svg>
            {{ section.settings.badge_1_text | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <span class="product-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            {{ section.settings.badge_2_text | escape }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="v2-shop">
      <div class="v2-seg-wrap">
        <div class="v2-seg" role="tablist" aria-label="Choose a product">
          <span class="v2-seg-ind" aria-hidden="true"></span>
          <button class="v2-seg-btn on" data-prod="digestive" role="tab">
            {{ section.settings.prod_1_title | escape }}
            <span class="v2-seg-sub">{{ section.settings.prod_1_subtitle | escape }}</span>
          </button>
          <button class="v2-seg-btn" data-prod="immune" role="tab">
            {{ section.settings.prod_2_title | escape }}
            <span class="v2-seg-sub">{{ section.settings.prod_2_subtitle | escape }}</span>
          </button>
          <button class="v2-seg-btn" data-prod="bundle" role="tab">
            {{ section.settings.prod_3_title | escape }}
            <span class="v2-seg-sub">{{ section.settings.prod_3_subtitle | escape }}</span>
          </button>
        </div>
      </div>

      {%- comment -%} DIGESTIVE PANEL {%- endcomment -%}
      <div class="v2-panel on" data-prod="digestive" role="tabpanel">
        <div class="v2-panel-inner">
          <div class="v2-media">
            <div class="v2-media-main">
              <div class="v2-media-stage">
                {%- assign p1_images = p1.images -%}
                {%- if section.settings.prod_1_img_1 != blank or section.settings.prod_1_img_2 != blank -%}
                  {%- if section.settings.prod_1_img_1 != blank -%}
                    <div class="v2-ph is-on">
                      {{ section.settings.prod_1_img_1 | image_url: width: 800 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                  {%- if section.settings.prod_1_img_2 != blank -%}
                    <div class="v2-ph">
                      {{ section.settings.prod_1_img_2 | image_url: width: 800 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                {%- elsif p1_images.size > 0 -%}
                  {%- for image in p1_images limit: 4 -%}
                    <div class="v2-ph {% if forloop.first %}is-on{% endif %}">
                      {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image.alt }}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="v2-ph v2-ph--green is-on">
                    {%- if settings.logo_inverse != blank -%}
                      {{ settings.logo_inverse | image_url: width: 400 | image_tag: class: 'v2-media-logo', loading: 'lazy' }}
                    {%- endif -%}
                  </div>
                  <div class="v2-ph v2-ph--green"></div>
                  <div class="v2-ph v2-ph--green"></div>
                  <div class="v2-ph v2-ph--green"></div>
                {%- endif -%}
              </div>
              <button class="v2-media-nav v2-media-nav--prev" type="button" aria-label="Previous image">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              </button>
              <button class="v2-media-nav v2-media-nav--next" type="button" aria-label="Next image">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
              </button>
            </div>
            
            <div class="v2-media-thumbs">
              {%- if section.settings.prod_1_img_1 != blank or section.settings.prod_1_img_2 != blank -%}
                {%- if section.settings.prod_1_img_1 != blank -%}
                  <div class="v2-ph is-active">
                    {{ section.settings.prod_1_img_1 | image_url: width: 120 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
                {%- if section.settings.prod_1_img_2 != blank -%}
                  <div class="v2-ph">
                    {{ section.settings.prod_1_img_2 | image_url: width: 120 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
              {%- elsif p1_images.size > 0 -%}
                {%- for image in p1_images limit: 4 -%}
                  <div class="v2-ph {% if forloop.first %}is-active{% endif %}">
                    {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt }}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="v2-ph is-active"></div>
                <div class="v2-ph"></div>
                <div class="v2-ph"></div>
                <div class="v2-ph"></div>
              {%- endif -%}
            </div>
          </div>
          
          <div class="v2-detail">
            <div class="v2-detail-eyebrow">{{ section.settings.prod_1_title | escape }} · Ginger</div>
            <h3 class="v2-detail-title">{{ section.settings.prod_1_title | escape }}</h3>
            {%- if section.settings.prod_1_desc_1 != blank -%}
              <p class="v2-detail-lede">{{ section.settings.prod_1_desc_1 | escape }}</p>
            {%- endif -%}
            {%- if section.settings.prod_1_desc_2 != blank -%}
              <p class="v2-detail-lede">{{ section.settings.prod_1_desc_2 | escape }}</p>
            {%- endif -%}
            
            <div class="v2-buy">
              <div class="v2-price-container">
                <span class="v2-price-label">Price</span>
                <span class="v2-price-amount">
                  {%- if p1 != blank -%}
                    {{ p1.price | money }}
                  {%- else -%}
                    $29.99
                  {%- endif -%}
                </span>
              </div>
              
              <form action="/cart/add" method="post" enctype="multipart/form-data" class="ww-product-form">
                <input type="hidden" name="id" value="{% if p1 != blank %}{{ p1.selected_or_first_available_variant.id }}{% endif %}">
                <input type="hidden" name="quantity" value="1" class="ww-qty-input">
                
                <div class="v2-buy-row">
                  <div class="v2-qty">
                    <button type="button" class="ww-qty-btn-minus" aria-label="Decrease quantity">−</button>
                    <span class="v">1</span>
                    <button type="button" class="ww-qty-btn-plus" aria-label="Increase quantity">+</button>
                  </div>
                  <button class="v2-add" type="submit" {% if p1 != blank and p1.available == false %}disabled{% endif %}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 4h2l2.4 11.5a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 8H6"></path>
                      <circle cx="10" cy="20" r="1.3"></circle>
                      <circle cx="17" cy="20" r="1.3"></circle>
                    </svg>
                    {% if p1 != blank and p1.available == false %}Sold out{% else %}Add to cart{% endif %}
                  </button>
                </div>
              </form>
              
              <div class="v2-buy-trust">
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12l2 2 4-4"></path>
                    <circle cx="12" cy="12" r="9"></circle>
                  </svg>
                  Free shipping $50+
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                  3rd-party tested
                </span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="v2-info">
          <details class="v2-acc">
            <summary>
              <span class="v2-acc-plus">+</span>
              <span class="v2-acc-t">Ingredients</span>
              <span class="v2-acc-c">4 items</span>
            </summary>
            <div class="v2-acc-body">
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Organic Ginger Root Extract <span class="amt">550 mg</span></h4>
                  <p>Standardized to contain 5% gingerols to deliver a consistent amount in every serving. Ginger has traditionally been used to support digestive comfort and maintain healthy gut motility*</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Rice Hulls</h4>
                  <p>Ground rice hulls from whole rice grain are used as a natural flow agent in the manufacturing process to support consistent dosing in every capsule.</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Rice Extract Blend</h4>
                  <p>A blend of rice extract, rice hulls, gum arabic, and sunflower oil that helps the capsules fill smoothly, so your serving is consistent every time.</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Hypromellose Capsule</h4>
                  <p>Vegetarian capsule made from plant-derived cellulose, with no gelatin or animal products.</p>
                </div>
              </div>
            </div>
          </details>
          
          <details class="v2-acc">
            <summary>
              <span class="v2-acc-plus">+</span>
              <span class="v2-acc-t">Product Information</span>
            </summary>
            <div class="v2-acc-body">
              <p class="v2-detail-lede" style="margin:0 0 14px"><strong>Directions:</strong> As a dietary supplement, take 2 capsules between meals.</p>
              <p class="v2-detail-lede" style="margin:0 0 14px"><strong>Caution:</strong> If you are pregnant or lactating, have any health condition, or are taking any medication, consult your health professional before use.</p>
              <p class="v2-detail-lede" style="margin:0 0 20px"><strong>Keep out of the reach of children.</strong> Store in a cool, dry place.</p>
              <div class="v2-sf-panel">
                <h4 class="v2-sf-h">Supplement Facts Panel</h4>
                <div class="v2-sf">
                  <div class="v2-sf-meta">Serving size: 2 capsules &nbsp;·&nbsp; Servings per container: 15</div>
                  <div class="v2-sf-row v2-sf-row--h"><span>&nbsp;</span><span>Amount per serving</span><span>% DV</span></div>
                  <div class="v2-sf-row"><span>Organic Ginger Root Extract (Zingiber officinale) (standardized to contain 5% gingerols)</span><span>550 mg</span><span>†</span></div>
                  <p class="v2-sf-note">† Daily Value (DV) not established.<br>Other ingredients: Hypromellose (cellulose) capsule, Rice Hulls, Rice Extract Blend.</p>
                </div>
              </div>
            </div>
          </details>
          
          <details class="v2-acc">
            <summary>
              <span class="v2-acc-plus">+</span>
              <span class="v2-acc-t">Capsule size</span>
            </summary>
            <div class="v2-acc-body">
              <div class="v2-capsize">
                <div class="v2-capsize-h">Capsule size, to scale</div>
                <p class="v2-capsize-sub">We wanted a capsule you don't have to psych yourself up for. So we made ours small enough to swallow without thinking about it. See for yourself.</p>
                <div class="v2-capsize-rows">
                  <div class="v2-caprow v2-caprow--ours">
                    <div class="v2-caplabel v2-caplabel--ours">
                      {%- if settings.logo_inverse != blank -%}
                        {{ settings.logo_inverse | image_url: width: 80 | image_tag: style: 'height:10px; width:auto; display:inline-block; margin-right:4px;' }}
                      {%- else -%}
                        <span>wanderWell</span>
                      {%- endif -%}
                      <small>Size 4</small>
                    </div>
                    <div class="v2-capbar">
                      <div class="v2-cap" style="width:114px;height:42px"></div>
                      <span class="v2-capdim">14.3 × 5.31 mm</span>
                    </div>
                  </div>
                  <div class="v2-caprow">
                    <div class="v2-caplabel">Common<small>Size 1</small></div>
                    <div class="v2-capbar">
                      <div class="v2-cap" style="width:155px;height:55px"></div>
                      <span class="v2-capdim">19.4 × 6.91 mm</span>
                    </div>
                  </div>
                  <div class="v2-caprow">
                    <div class="v2-caplabel">Common<small>Size 0</small></div>
                    <div class="v2-capbar">
                      <div class="v2-cap" style="width:174px;height:61px"></div>
                      <span class="v2-capdim">21.7 × 7.64 mm</span>
                    </div>
                  </div>
                  <div class="v2-caprow">
                    <div class="v2-caplabel">Typical<small>Size 00</small></div>
                    <div class="v2-capbar">
                      <div class="v2-cap" style="width:186px;height:68px"></div>
                      <span class="v2-capdim">23.3 × 8.53 mm</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </details>
          
          <div class="v2-info-trust">
            <div class="v2-info-trust-h">Commitment to Quality</div>
            <div class="v2-info-trust-grid">
              <div>
                <h4>Third-party testing</h4>
                <p>Every finished product lot is tested by independent labs for microbial contamination, heavy metals, and glyphosate. We also conduct third-party testing to verify that our products meet applicable label claims and potency specifications.</p>
              </div>
              <div>
                <h4>Manufacturing excellence</h4>
                <p>Our products are manufactured in the U.S. in FDA-registered, NSF GMP-certified facilities with ingredients that are sourced globally.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} IMMUNE PANEL {%- endcomment -%}
      <div class="v2-panel" data-prod="immune" role="tabpanel">
        <div class="v2-panel-inner">
          <div class="v2-media">
            <div class="v2-media-main">
              <div class="v2-media-stage">
                {%- assign p2_images = p2.images -%}
                {%- if section.settings.prod_2_img_1 != blank or section.settings.prod_2_img_2 != blank -%}
                  {%- if section.settings.prod_2_img_1 != blank -%}
                    <div class="v2-ph is-on">
                      {{ section.settings.prod_2_img_1 | image_url: width: 800 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                  {%- if section.settings.prod_2_img_2 != blank -%}
                    <div class="v2-ph">
                      {{ section.settings.prod_2_img_2 | image_url: width: 800 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                {%- elsif p2_images.size > 0 -%}
                  {%- for image in p2_images limit: 4 -%}
                    <div class="v2-ph {% if forloop.first %}is-on{% endif %}">
                      {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image.alt }}
                    </div>
                  {%- endfor -%}
                {%- else -%}
