{% comment %}
  Section: WW Products Hub
  Description: Custom interactive tabbed product interface utilizing blocks.

  -----------------------------------------------------------------------------
  DYNAMIC METAFIELDS (Shopify Custom Fields) DEFINITIONS:
  To load tab values automatically from a selected product instead of manual block
  overrides, create the following metafields on your Shopify Product admin:

  1. Subtitle (Single line text):
     Namespace & Key: custom.subtitle
     Example: "Capsules · Ginger" or "Powder · Vitamin C"

  2. Ingredients Panel (Rich Text / HTML):
     Namespace & Key: custom.ingredients
     Used for the dynamic list of ingredients inside Accordion 1.

  3. Product Information (Rich Text / HTML):
     Namespace & Key: custom.product_information
     Used for Directions, cautions, and Supplement Facts tables inside Accordion 2.

  4. Capsule Details (Rich Text / HTML):
     Namespace & Key: custom.capsule_details
     Used for custom capsule notes or text descriptions inside Accordion 3.
  -----------------------------------------------------------------------------
{% endcomment %}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.layout_width == 'full' -%}
    .section-{{ section.id }} .container {
      max-width: none !important;
      width: 100%;
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}
{%- endstyle -%}

<section class="products section-{{ section.id }}" id="products" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="products-header">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}

      <div class="products-badges">
        {%- if section.settings.badge_1_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21v-9"></path>
              <path d="M12 12c0-4 -3-6-7-6 0 4 3 6 7 6z"></path>
              <path d="M12 12c0-5 3-8 8-8 0 5-3 8-8 8z"></path>
            </svg>
            {{ section.settings.badge_1_text | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            {{ section.settings.badge_2_text | escape }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="ww-shop">
      <div class="ww-seg-wrap">
        <div class="ww-seg" role="tablist" aria-label="Choose a product">
          <span class="ww-seg-ind" aria-hidden="true"></span>
          {%- assign is_first_tab = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_tab' -%}
              {%- assign current_prod = block.settings.product -%}
              {%- assign title = block.settings.title | default: current_prod.title -%}
              {%- assign subtitle = block.settings.subtitle
                | default: current_prod.metafields.custom.subtitle.value
                | default: current_prod.metafields.custom.subtitle
              -%}
              <button
                class="ww-seg-btn {% if is_first_tab %}on{% endif %}"
                data-prod="block-{{ block.id }}"
                role="tab"
                {{ block.shopify_attributes }}
              >
                {{ title | escape }}
                <span class="ww-seg-sub">{{ subtitle | escape }}</span>
              </button>
              {%- assign is_first_tab = false -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'product_tab' -%}
          {%- assign current_prod = block.settings.product -%}
          {%- assign key = 'block-' | append: block.id -%}

          {%- assign title = block.settings.title | default: current_prod.title -%}
          {%- assign subtitle = block.settings.subtitle
            | default: current_prod.metafields.custom.subtitle.value
            | default: current_prod.metafields.custom.subtitle
          -%}
          {%- assign desc = block.settings.description | default: current_prod.description -%}

          <div
            class="ww-panel {% if forloop.first %}on{% endif %}"
            data-prod="{{ key }}"
            role="tabpanel"
            {{ block.shopify_attributes }}
          >
            <div class="ww-panel-inner">
              <div class="ww-media">
                <div class="ww-media-main">
                  <div class="ww-media-stage">
                    {%- assign product_images = current_prod.images -%}

                    {%- if product_images.size > 0 -%}
                      {%- for image in product_images limit: 4 -%}
                        <div class="ww-media-slide {% if forloop.first %}is-on{% endif %}">
                          {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image.alt }}
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      <div class="ww-media-slide is-on">
                        {%- if settings.logo_inverse != blank -%}
                          {{
                            settings.logo_inverse
                            | image_url: width: 400
                            | image_tag: class: 'ww-media-logo', loading: 'lazy'
                          }}
                        {%- endif -%}
                      </div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                    {%- endif -%}
                  </div>

                  {%- assign has_multiple_images = false -%}
                  {%- if product_images.size > 1 -%}
                    {%- assign has_multiple_images = true -%}
                  {%- endif -%}

                  {%- if has_multiple_images -%}
                    <button class="ww-media-nav ww-media-nav--prev" type="button" aria-label="Previous image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15 5l-7 7 7 7"></path>
                      </svg>
                    </button>
                    <button class="ww-media-nav ww-media-nav--next" type="button" aria-label="Next image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 5l7 7-7 7"></path>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>

                <div class="ww-media-thumbs">
                  {%- if product_images.size > 0 -%}
                    {%- for image in product_images limit: 4 -%}
                      <div class="ww-media-thumb {% if forloop.first %}is-active{% endif %}">
                        {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt }}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    <div class="ww-media-thumb is-active"></div>
                    <div class="ww-media-thumb"></div>
                    <div class="ww-media-thumb"></div>
                    <div class="ww-media-thumb"></div>
                  {%- endif -%}
                </div>
              </div>

              <div class="ww-detail">
                <div class="ww-detail-eyebrow">{{ title | escape }} · {{ subtitle | escape }}</div>
                <h3 class="ww-detail-title">{{ title | escape }}</h3>

                {%- if desc != blank -%}
                  <p class="ww-detail-lede">{{ desc }}</p>
                {%- endif -%}

                {%- if current_prod != blank -%}
                  <div class="ww-buy">
                    {%- assign product_form_id = 'ww-product-form-' | append: block.id -%}
                    <product-form-component
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ current_prod.id }}"
                      data-product-url="{{ current_prod.url }}"
                      on:submit="/handleSubmit"
                      data-quantity-default="1"
                    >
                      <div
                        class="visually-hidden"
                        aria-live="assertive"
                        role="status"
                        aria-atomic="true"
                        ref="liveRegion"
                      ></div>
                      {%- form 'product',
                        current_prod,
                        id: product_form_id,
                        class: 'ww-product-form',
                        data-type: 'add-to-cart-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          ref="variantId"
                          value="{{ current_prod.selected_or_first_available_variant.id }}"
                        >
                        <input type="hidden" name="quantity" value="1" class="ww-qty-input">

                        {% render 'ww-product-purchase-options', current_prod: current_prod, block: block %}

                        <div class="ww-buy-row">
                          <div class="ww-qty">
                            <button type="button" class="ww-qty-btn-minus" aria-label="Decrease quantity">−</button>
                            <span class="v">1</span>
                            <button type="button" class="ww-qty-btn-plus" aria-label="Increase quantity">+</button>
                          </div>

                          {%- assign add_to_cart_text = 'products.product.add_to_cart' | t -%}
                          {%- if current_prod.available == false -%}
                            {%- assign add_to_cart_text = 'products.product.sold_out' | t -%}
                          {%- endif -%}

                          {% render 'add-to-cart-button',
                            product: current_prod,
                            can_add_to_cart: current_prod.available,
                            show_icon: true,
                            add_to_cart_text: add_to_cart_text,
                            class: 'ww-add'
                          %}
                        </div>
                      {%- endform -%}
                    </product-form-component>

                    <div class="ww-buy-trust">
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M9 12l2 2 4-4"></path>
                          <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        Free shipping $50+
                      </span>
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
                          <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        3rd-party tested
                      </span>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>

            <div class="ww-info">
              {%- assign found_our_tab = false -%}
              {%- for sub_block in section.blocks -%}
                {%- if sub_block.id == block.id -%}
                  {%- assign found_our_tab = true -%}
                {%- elsif sub_block.type == 'product_tab' -%}
                  {%- if found_our_tab -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if found_our_tab and sub_block.type == 'accordion' -%}
                  {%- assign acc_title = sub_block.settings.title | default: 'Ingredients' -%}
                  {%- assign acc_type = sub_block.settings.content_type -%}
                  {%- assign acc_content = '' -%}

                  {%- if acc_type == 'custom' -%}
                    {%- assign acc_content = sub_block.settings.content -%}
                  {%- elsif acc_type == 'ingredients' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-ingredients', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'bundle' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-bundle', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'supplement_facts' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-supplement-facts', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'capsule_size' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-capsule', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- endif -%}

                  {%- assign show_acc = false -%}
                  {%- if acc_content != blank -%}
                    {%- assign show_acc = true -%}
                  {%- endif -%}

                  {%- if show_acc -%}
                    <details class="ww-acc" {{ sub_block.shopify_attributes }}>
                      <summary>
                        <span class="ww-acc-plus">+</span>
                        <span class="ww-acc-t">{{ acc_title | escape }}</span>
                        {%- if sub_block.settings.items_count != blank -%}
                          <span class="ww-acc-c">{{ sub_block.settings.items_count | escape }}</span>
                        {%- elsif acc_type == 'ingredients' -%}
                          {%- assign ingredients_list = current_prod.metafields.custom.ingredients.value -%}
                          {%- if ingredients_list != blank -%}
                            <span class="ww-acc-c">{{ ingredients_list.size }} items</span>
                          {%- endif -%}
                        {%- elsif acc_type == 'bundle' -%}
                          {%- assign bundle_products = blank -%}
                          {%- assign bundle_rules = shop.metafields.appstle_bundles.bundle_rules.value -%}
                          {%- if bundle_rules != blank -%}
                            {%- for rule in bundle_rules -%}
                              {%- if rule.bundleProductId == current_prod.id or rule.productId == current_prod.id -%}
                                {%- assign bundle_products = rule.products -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {%- if bundle_products != blank -%}
                            <span class="ww-acc-c">{{ bundle_products }} products</span>
                          {%- endif -%}
                        {%- endif -%}
                      </summary>
                      <div class="ww-acc-body">
                        {{ acc_content }}
                      </div>
                    </details>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if section.settings.trust_heading != blank -%}
                <div class="ww-info-trust">
                  <div class="ww-info-trust-h">{{ section.settings.trust_heading | escape }}</div>
                  <div class="ww-info-trust-grid">
                    {%- if section.settings.trust_item_1_title != blank
                      or section.settings.trust_item_1_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_1_title != blank -%}
                          <h4>{{ section.settings.trust_item_1_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_1_text != blank -%}
                          <p>{{ section.settings.trust_item_1_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if section.settings.trust_item_2_title != blank
                      or section.settings.trust_item_2_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_2_title != blank -%}
                          <h4>{{ section.settings.trust_item_2_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_2_text != blank -%}
                          <p>{{ section.settings.trust_item_2_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <!-- Close .ww-info -->
          </div>
          <!-- Close .ww-panel -->
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'ww-product.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('click', function (e) {
      const opt = e.target.closest('.ww-sub-opt');
      if (!opt) return;

      const radio = opt.querySelector('.ww-sub-opt__radio-input');
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }

      const container = opt.closest('.ww-purchase-options');
      if (container) {
        container.querySelectorAll('.ww-sub-opt').forEach((item) => item.classList.remove('on'));
      }
      opt.classList.add('on');
    });
  });
</script>

{% stylesheet %}
  .products {
    background-color: var(--offwhite);
  }
  .products-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .products-header .section-label {
    display: block;
    font-size: 2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin: 0 0 16px;
  }
  .products-header .section-title {
    font-size: 2.6rem;
    font-weight: 500;
    color: var(--charcoal);
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-wrap: balance;
  }
  .products-header .section-subtitle {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0 0 20px;
  }
  .products-badges {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .product-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-primary);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--charcoal);
    background-color: var(--cream);
    padding: 6px 12px;
    border-radius: 99px;
  }
  .product-badge svg {
    width: 14px;
    height: 14px;
    color: var(--orange);
  }

  .ww-shop {
    margin-top: 8px;
  }
  .ww-seg {
    display: flex;
    gap: 6px;
    background: var(--ww-color-white, #fff);
    border: 1px solid rgba(44,44,44,.1);
    border-radius: 999px;
    padding: 6px;
    max-width: 640px;
    margin: 0 auto 40px;
    box-shadow: 0 1px 4px rgba(28,28,26,.08);
  }
  .ww-seg-btn {
    flex: 1;
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 13px 10px;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .82rem;
    letter-spacing: .02em;
    color: var(--charcoal);
    text-transform: uppercase;
    transition: color .25s;
    min-height: 46px;
  }
  .ww-seg-btn .ww-seg-sub {
    display: block;
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: .62rem;
    letter-spacing: .06em;
    opacity: .6;
    margin-top: 2px;
    text-transform: none;
  }
  .ww-seg-btn.on {
    color: var(--ww-color-white, #fff);
  }
  .ww-seg-ind {
    position: absolute;
    top: 6px;
    bottom: 6px;
    border-radius: 999px;
    background: var(--orange);
    z-index: 0;
    transition: left .35s cubic-bezier(.4,0,.2,1), width .35s cubic-bezier(.4,0,.2,1);
    box-shadow: 0 4px 24px rgba(242,101,48,.2);
  }
  .ww-seg-wrap {
    position: relative;
  }

  .ww-panel {
    display: none;
    animation: ww-fade-up .5s cubic-bezier(.22,.61,.36,1);
  }
  .ww-panel.on {
    display: block;
  }
  @keyframes ww-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ww-panel-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    background: var(--ww-color-white, #fff);
    border-radius: 24px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(28,28,26,.1);
    border: 1px solid rgba(44,44,44,.06);
  }

  /* Media side */
  .ww-media {
    position: relative;
  }
  .ww-media-main {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
  }
  .ww-media-stage {
    display: flex;
    width: 100%;
    aspect-ratio: 4/5;
    position: relative;
  }
  .ww-media-stage .ww-media-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background-color: var(--cream);
    overflow: hidden;
  }
  .ww-media-stage .ww-media-slide.is-on {
    opacity: 1;
    visibility: visible;
    position: relative;
  }
  .ww-media-stage .ww-media-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ww-media-slide--green {
    background: linear-gradient(135deg, #e3ede3 0%, #c8dcd0 100%) !important;
  }
  .ww-media-slide--warm {
    background: linear-gradient(135deg, #fbeee7 0%, #f4d4c5 100%) !important;
  }
  .ww-media-logo {
    position: relative;
    z-index: 2;
    width: 56%;
    opacity: .9;
  }

  .ww-media-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: background 0.2s, transform 0.2s;
  }
  .ww-media-nav:hover {
    background: var(--ww-color-white, #fff);
    transform: translateY(-50%) scale(1.05);
  }
  .ww-media-nav svg {
    width: 18px;
    height: 18px;
    stroke: var(--charcoal);
    stroke-width: 2.5;
    fill: none;
  }
  .ww-media-nav--prev {
    left: 12px;
  }
  .ww-media-nav--next {
    right: 12px;
  }

  .ww-media-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .ww-media-thumbs .ww-media-thumb {
    width: calc(25% - 6px);
    aspect-ratio: 1/1;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--cream);
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .ww-media-thumbs .ww-media-thumb.is-active {
    border-color: var(--orange);
  }
  .ww-media-thumbs .ww-media-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Detail side */
  .ww-detail-eyebrow {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 8px;
  }
  .ww-detail-title {
    font-family: var(--font-tertiary);
    font-weight: 500;
    font-size: 2.1rem;
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--charcoal);
    margin-bottom: 10px;
  }
  .ww-detail-lede {
    font-size: .98rem;
    line-height: 1.6;
    color: var(--charcoal-light);
    margin-bottom: 18px;
    letter-spacing: -.01em;
  }

  /* Buy box */
  .ww-buy {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid rgba(44,44,44,.12);
  }
  .ww-price-container {
    margin-bottom: 20px;
  }
  .ww-price-label {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--charcoal-light);
    display: block;
    margin-bottom: 2px;
    letter-spacing: 0.05em;
  }
  .ww-price-amount {
    font-family: var(--font-tertiary);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--charcoal);
    letter-spacing: -0.02em;
  }

  .ww-buy-row {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }
  .ww-qty {
    display: flex;
    align-items: center;
    border: 1.5px solid rgba(44,44,44,.15);
    border-radius: 999px;
    overflow: hidden;
    background: var(--ww-color-white, #fff);
  }
  .ww-qty button {
    border: none;
    background: transparent;
    width: 44px;
    height: 52px;
    font-size: 1.3rem;
    cursor: pointer;
    color: var(--charcoal);
    line-height: 1;
  }
  .ww-qty .v {
    min-width: 26px;
    text-align: center;
    font-weight: 700;
    font-family: var(--font-primary);
    font-size: 1rem;
    color: var(--charcoal);
  }
  .ww-add {
    flex: 1;
    border: none;
    border-radius: 999px;
    background: var(--orange);
    color: var(--ww-color-white, #fff);
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .95rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 52px;
    transition: background .2s, transform .1s;
  }
  .ww-add svg {
    width: 18px;
    height: 18px;
  }
  .ww-add:hover {
    background: var(--orange-dark);
  }
  .ww-add:active {
    transform: scale(.98);
  }
  .ww-add.is-added {
    background: #5AB08A !important;
  }
  .ww-buy-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
    font-family: var(--font-primary);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--charcoal-light);
  }
  .ww-buy-trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ww-buy-trust svg {
    width: 14px;
    height: 14px;
    color: var(--orange);
  }

  /* Info and Accordions */
  .ww-info {
  max-width: 880px;
    margin: 28px auto 0;
    background: var(--ww-color-white, #fff);
    border-radius: 24px;
    padding: 36px 32px;
    border: 1px solid rgba(44, 44, 44, .06);
  }
  .ww-acc {
    border-bottom: 1px solid rgba(44,44,44,.1);
    padding: 18px 0;
  }
  .ww-acc summary {
    list-style: none;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--charcoal);
  }
  .ww-acc summary::-webkit-details-marker {
    display: none;
  }
  .ww-acc-plus {
    font-size: 1.25rem;
    margin-right: 12px;
    color: var(--orange);
    font-weight: 600;
    transition: transform 0.25s;
    line-height: 1;
  }
  .ww-acc[open] .ww-acc-plus {
    transform: rotate(45deg);
  }
  .ww-acc-t {
    flex: 1;
  }
  .ww-acc-c {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--charcoal-light);
    background: var(--cream);
    padding: 4px 10px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ww-acc-body {
    padding: 16px 12px 8px;
    animation: ww-fade-in .3s ease-out;
  }
  @keyframes ww-fade-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .ww-ing {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(44,44,44,.08);
  }
  .ww-ing:last-child {
    border-bottom: none;
  }
  .ww-ing-dot {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--orange);
    margin-top: 5px;
  }
  .ww-ing h4 {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: .92rem;
    color: var(--charcoal);
    margin: 0 0 3px;
    letter-spacing: -.01em;
  }
  .ww-ing p {
    font-size: .85rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0;
  }
  .ww-ing .amt {
    font-family: var(--font-primary);
    font-size: .72rem;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: .04em;
    margin-left: 6px;
  }

  .ww-sf-panel {
    background: var(--cream);
    border-radius: 16px;
    padding: 16px;
    margin-top: 14px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .ww-sf-h {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 10px;
    color: var(--charcoal);
    border-bottom: 2px solid var(--charcoal);
    padding-bottom: 6px;
  }
  .ww-sf-meta {
    font-size: 0.8rem;
    color: var(--charcoal);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .ww-sf-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid rgba(44,44,44,0.12);
    font-size: 0.8rem;
  }
  .ww-sf-row span:nth-child(1) {
    flex: 1;
    font-weight: 500;
    color: var(--charcoal);
  }
  .ww-sf-row span:nth-child(2) {
    width: 90px;
    text-align: right;
    font-weight: 600;
  }
  .ww-sf-row span:nth-child(3) {
    width: 60px;
    text-align: right;
    font-weight: 600;
  }
  .ww-sf-row--h {
    font-weight: 700;
    border-bottom: 1.5px solid var(--charcoal);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
  .ww-sf-row--h span {
    color: var(--charcoal) !important;
  }
  .ww-sf-note {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--charcoal-light);
    margin: 8px 0 0;
  }

  .ww-info-trust {
    margin-top: 24px;
    background: var(--cream);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .ww-info-trust-h {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1rem;
    color: var(--charcoal);
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding-bottom: 8px;
  }
  .ww-info-trust-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ww-info-trust-grid h4 {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 4px;
    color: var(--charcoal);
  }
  .ww-info-trust-grid p {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--charcoal-light);
    margin: 0;
  }


  /* Steps and Bundles */
  .ww-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ww-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .ww-step-n {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--orange);
    font-family: var(--font-tertiary);
    font-weight: 700;
    display: grid;
    place-items: center;
    font-size: .9rem;
  }
  .ww-step h4 {
    font-size: .92rem;
    font-weight: 700;
    color: var(--charcoal);
    margin: 2px 0 2px;
  }
  .ww-step p {
    font-size: .85rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0;
  }
  .ww-steps-note {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--charcoal-light);
    margin: 8px 0 0;
  }

  .ww-bundle-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ww-bundle-item {
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--cream);
    border-radius: 14px;
    padding: 12px;
  }
  .ww-bundle-item .ww-bundle-thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-color: var(--cream);
    background-size: cover;
    background-position: center;
  }
  .ww-bundle-item .ww-bundle-thumb:nth-child(1) {
    background-color: #c8dcd0;
  }
  .ww-bundle-item .ww-bundle-thumb:nth-child(2) {
    background-color: #fbeee7;
  }
  .ww-bundle-item h4 {
    font-family: var(--font-tertiary);
    font-size: .95rem;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 2px;
  }
  .ww-bundle-item p {
    font-size: .8rem;
    color: var(--charcoal-light);
    margin: 0;
  }
  .ww-bundle-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--orange-pale);
    color: var(--orange-dark);
    border-radius: 12px;
    padding: 10px 14px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .85rem;
    margin-top: 14px;
  }

  /* Responsive styles */
  @media screen and (min-width: 760px) {
    .products-header .section-title {
      font-size: 3rem;
    }
    .ww-panel-inner {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 36px;
      padding: 28px;
    }
    .ww-detail-title {
      font-size: 2.6rem;
    }
    .ww-info {
      margin-top: 36px;
    }
    .ww-info-trust-grid {
      flex-direction: row;
      gap: 24px;
    }
    .ww-info-trust-grid > div {
      flex: 1;
    }
  }

  @media screen and (min-width: 1024px) {
    .ww-detail-title {
      font-size: 3rem;
    }
    .ww-panel-inner {
      padding: 36px;
      gap: 48px;
    }
  }

  @media screen and (max-width: 759px) {
    .ww-seg {
      max-width: 100%;
    }
    .ww-seg-btn {
      font-size: .72rem;
      padding: 11px 4px;
    }
    .ww-buy-row {
      flex-wrap: wrap;
    }
    .ww-add {
      flex: 1 1 100%;
      order: 2;
    }
    .ww-qty {
      order: 1;
    }
  }
{% endstylesheet %}

