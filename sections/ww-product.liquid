                    {%- if settings.logo_inverse != blank -%}
                      {{ settings.logo_inverse | image_url: width: 400 | image_tag: class: 'v2-media-logo', loading: 'lazy' }}
                    {%- endif -%}
                  </div>
                  <div class="v2-ph"></div>
                  <div class="v2-ph"></div>
                  <div class="v2-ph"></div>
                {%- endif -%}
              </div>
              <button class="v2-media-nav v2-media-nav--prev" type="button" aria-label="Previous image">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              </button>
              <button class="v2-media-nav v2-media-nav--next" type="button" aria-label="Next image">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
              </button>
            </div>
            
            <div class="v2-media-thumbs">
              {%- if section.settings.prod_2_img_1 != blank or section.settings.prod_2_img_2 != blank -%}
                {%- if section.settings.prod_2_img_1 != blank -%}
                  <div class="v2-ph is-active">
                    {{ section.settings.prod_2_img_1 | image_url: width: 120 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
                {%- if section.settings.prod_2_img_2 != blank -%}
                  <div class="v2-ph">
                    {{ section.settings.prod_2_img_2 | image_url: width: 120 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
              {%- elsif p2_images.size > 0 -%}
                {%- for image in p2_images limit: 4 -%}
                  <div class="v2-ph {% if forloop.first %}is-active{% endif %}">
                    {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt }}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="v2-ph is-active"></div>
                <div class="v2-ph"></div>
                <div class="v2-ph"></div>
                <div class="v2-ph"></div>
              {%- endif -%}
            </div>
          </div>
          
          <div class="v2-detail">
            <div class="v2-detail-eyebrow">{{ section.settings.prod_2_title | escape }} · Vitamin C</div>
            <h3 class="v2-detail-title">{{ section.settings.prod_2_title | escape }}</h3>
            {%- if section.settings.prod_2_desc_1 != blank -%}
              <p class="v2-detail-lede">{{ section.settings.prod_2_desc_1 | escape }}</p>
            {%- endif -%}
            {%- if section.settings.prod_2_desc_2 != blank -%}
              <p class="v2-detail-lede">{{ section.settings.prod_2_desc_2 | escape }}</p>
            {%- endif -%}
            
            <div class="v2-buy">
              <div class="v2-price-container">
                <span class="v2-price-label">Price</span>
                <span class="v2-price-amount">
                  {%- if p2 != blank -%}
                    {{ p2.price | money }}
                  {%- else -%}
                    $29.99
                  {%- endif -%}
                </span>
              </div>
              
              <form action="/cart/add" method="post" enctype="multipart/form-data" class="ww-product-form">
                <input type="hidden" name="id" value="{% if p2 != blank %}{{ p2.selected_or_first_available_variant.id }}{% endif %}">
                <input type="hidden" name="quantity" value="1" class="ww-qty-input">
                
                <div class="v2-buy-row">
                  <div class="v2-qty">
                    <button type="button" class="ww-qty-btn-minus" aria-label="Decrease quantity">−</button>
                    <span class="v">1</span>
                    <button type="button" class="ww-qty-btn-plus" aria-label="Increase quantity">+</button>
                  </div>
                  <button class="v2-add" type="submit" {% if p2 != blank and p2.available == false %}disabled{% endif %}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 4h2l2.4 11.5a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 8H6"></path>
                      <circle cx="10" cy="20" r="1.3"></circle>
                      <circle cx="17" cy="20" r="1.3"></circle>
                    </svg>
                    {% if p2 != blank and p2.available == false %}Sold out{% else %}Add to cart{% endif %}
                  </button>
                </div>
              </form>
              
              <div class="v2-buy-trust">
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12l2 2 4-4"></path>
                    <circle cx="12" cy="12" r="9"></circle>
                  </svg>
                  Free shipping $50+
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                  3rd-party tested
                </span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="v2-info">
          <details class="v2-acc">
            <summary>
              <span class="v2-acc-plus">+</span>
              <span class="v2-acc-t">Ingredients</span>
              <span class="v2-acc-c">6 items</span>
            </summary>
            <div class="v2-acc-body">
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Vitamin C <span class="amt">300 mg</span></h4>
                  <p>300 mg per serving to support immune function.*</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Zinc <span class="amt">16 mg</span></h4>
                  <p>An essential mineral your immune cells need to develop and function properly.*</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Lysine <span class="amt">96 mg</span></h4>
                  <p>An essential amino acid that works alongside other nutrients to support immune function.*</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
                <div>
                  <h4>Niacinamide (Vitamin B3) <span class="amt">25 mg</span></h4>
                  <p>The no-flush form, to avoid the redness and tingling other forms can trigger. Supports the cellular energy your immune cells need to function.*</p>
                </div>
              </div>
              <div class="v2-ing">
                <div class="v2-ing-dot"></div>
