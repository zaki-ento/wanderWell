{% comment %}
  Section: WW Products Hub
  Description: Custom interactive tabbed product interface utilizing blocks.

  -----------------------------------------------------------------------------
  DYNAMIC METAFIELDS (Shopify Custom Fields) DEFINITIONS:
  To load tab values automatically from a selected product instead of manual block
  overrides, create the following metafields on your Shopify Product admin:

  1. Subtitle (Single line text):
     Namespace & Key: custom.subtitle
     Example: "Capsules · Ginger" or "Powder · Vitamin C"

  2. Ingredients Panel (Rich Text / HTML):
     Namespace & Key: custom.ingredients
     Used for the dynamic list of ingredients inside Accordion 1.

  3. Product Information (Rich Text / HTML):
     Namespace & Key: custom.product_information
     Used for Directions, cautions, and Supplement Facts tables inside Accordion 2.

  4. Capsule Details (Rich Text / HTML):
     Namespace & Key: custom.capsule_details
     Used for custom capsule notes or text descriptions inside Accordion 3.
  -----------------------------------------------------------------------------
{% endcomment %}

{{ 'ww-product.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.layout_width == 'full' -%}
    .section-{{ section.id }} .container {
      max-width: none !important;
      width: 100%;
      padding-left: 40px;
      padding-right: 40px;
    }
  {%- endif -%}
{%- endstyle -%}

<section class="ww-products section-{{ section.id }}" id="ww-products" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="products-header">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}

      <div class="products-badges">
        {%- if section.settings.badge_1_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21v-9"></path>
              <path d="M12 12c0-4 -3-6-7-6 0 4 3 6 7 6z"></path>
              <path d="M12 12c0-5 3-8 8-8 0 5-3 8-8 8z"></path>
            </svg>
            {{ section.settings.badge_1_text | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <span class="product-badge">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            {{ section.settings.badge_2_text | escape }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="ww-shop">
      <div class="ww-seg-wrap">
        <div class="ww-seg" role="tablist" aria-label="Choose a product">
          <span class="ww-seg-ind" aria-hidden="true"></span>
          {%- assign is_first_tab = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_tab' -%}
              {%- assign current_prod = block.settings.product -%}
              {%- assign title = block.settings.title | default: current_prod.title -%}
              {%- assign subtitle = block.settings.subtitle
                | default: current_prod.metafields.custom.subtitle.value
                | default: current_prod.metafields.custom.subtitle
              -%}
              <button
                class="ww-seg-btn {% if is_first_tab %}on{% endif %}"
                data-prod="block-{{ block.id }}"
                role="tab"
                {{ block.shopify_attributes }}
              >
                {{ title | escape }}
                <span class="ww-seg-sub">{{ subtitle | escape }}</span>
              </button>
              {%- assign is_first_tab = false -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'product_tab' -%}
          {%- assign current_prod = block.settings.product -%}
          {%- assign key = 'block-' | append: block.id -%}

          {%- assign title = block.settings.title | default: current_prod.title -%}
          {%- assign subtitle = block.settings.subtitle
            | default: current_prod.metafields.custom.subtitle.value
            | default: current_prod.metafields.custom.subtitle
          -%}
          {%- assign desc = block.settings.description | default: current_prod.description -%}

          <div
            class="ww-panel {% if forloop.first %}on{% endif %}"
            data-prod="{{ key }}"
            role="tabpanel"
            {{ block.shopify_attributes }}
          >
            <div class="ww-panel-inner">
              <div class="ww-media">
                <div class="ww-media-main">
                  <div class="ww-media-stage">
                    {%- assign product_images = current_prod.images -%}

                    {%- if product_images.size > 0 -%}
                      {%- for image in product_images limit: 4 -%}
                        <div class="ww-media-slide {% if forloop.first %}is-on{% endif %}">
                          {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image.alt }}
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      <div class="ww-media-slide is-on">
                        {%- if settings.logo_inverse != blank -%}
                          {{
                            settings.logo_inverse
                            | image_url: width: 400
                            | image_tag: class: 'ww-media-logo', loading: 'lazy'
                          }}
                        {%- endif -%}
                      </div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                      <div class="ww-media-slide"></div>
                    {%- endif -%}
                  </div>

                  {%- assign has_multiple_images = false -%}
                  {%- if product_images.size > 1 -%}
                    {%- assign has_multiple_images = true -%}
                  {%- endif -%}

                  {%- if has_multiple_images -%}
                    <button class="ww-media-nav ww-media-nav--prev" type="button" aria-label="Previous image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15 5l-7 7 7 7"></path>
                      </svg>
                    </button>
                    <button class="ww-media-nav ww-media-nav--next" type="button" aria-label="Next image">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 5l7 7-7 7"></path>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>

                <div class="ww-media-thumbs">
                  {%- if product_images.size > 0 -%}
                    {%- for image in product_images limit: 4 -%}
                      <div class="ww-media-thumb {% if forloop.first %}is-active{% endif %}">
                        {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt }}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    <div class="ww-media-thumb is-active"></div>
                    <div class="ww-media-thumb"></div>
                    <div class="ww-media-thumb"></div>
                    <div class="ww-media-thumb"></div>
                  {%- endif -%}
                </div>
              </div>

              <div class="ww-detail">
                <div class="ww-detail-eyebrow">{{ title | escape }} · {{ subtitle | escape }}</div>
                <h3 class="ww-detail-title">{{ title | escape }}</h3>

                {%- if desc != blank -%}
                  <p class="ww-detail-lede">{{ desc }}</p>
                {%- endif -%}

                {%- if current_prod != blank -%}
                  <div class="ww-buy">
                    {%- assign product_form_id = 'ww-product-form-' | append: block.id -%}
                    <product-form-component
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ current_prod.id }}"
                      data-product-url="{{ current_prod.url }}"
                      on:submit="/handleSubmit"
                      data-quantity-default="1"
                    >
                      <div
                        class="visually-hidden"
                        aria-live="assertive"
                        role="status"
                        aria-atomic="true"
                        ref="liveRegion"
                      ></div>
                      {%- form 'product',
                        current_prod,
                        id: product_form_id,
                        class: 'ww-product-form',
                        data-type: 'add-to-cart-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          ref="variantId"
                          value="{{ current_prod.selected_or_first_available_variant.id }}"
                        >
                        <input type="hidden" name="quantity" value="1" class="ww-qty-input">

                        {% render 'ww-product-purchase-options', current_prod: current_prod, block: block %}

                        <span class="product-form-text__error hidden" ref="addToCartTextError">
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </span>

                        <div class="ww-buy-row">
                          <div class="ww-qty">
                            <button type="button" class="ww-qty-btn-minus" aria-label="Decrease quantity">−</button>
                            <span class="v">1</span>
                            <button type="button" class="ww-qty-btn-plus" aria-label="Increase quantity">+</button>
                          </div>

                          {%- assign add_to_cart_text = 'products.product.add_to_cart' | t -%}
                          {%- if current_prod.available == false -%}
                            {%- assign add_to_cart_text = 'products.product.sold_out' | t -%}
                          {%- endif -%}

                          {% render 'add-to-cart-button',
                            product: current_prod,
                            can_add_to_cart: current_prod.available,
                            show_icon: true,
                            add_to_cart_text: add_to_cart_text,
                            class: 'ww-add'
                          %}
                        </div>
                      {%- endform -%}
                    </product-form-component>

                    <div class="ww-buy-trust">
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M9 12l2 2 4-4"></path>
                          <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        Free shipping $50+
                      </span>
                      <span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 2l-9 4.5V12c0 5 4 9 9 10 5-1 9-5 9-10V6.5L12 2z"></path>
                          <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        3rd-party tested
                      </span>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>

            <div class="ww-info">
              {%- assign found_our_tab = false -%}
              {%- for sub_block in section.blocks -%}
                {%- if sub_block.id == block.id -%}
                  {%- assign found_our_tab = true -%}
                {%- elsif sub_block.type == 'product_tab' -%}
                  {%- if found_our_tab -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if found_our_tab and sub_block.type == 'accordion' -%}
                  {%- assign acc_title = sub_block.settings.title | default: 'Ingredients' -%}
                  {%- assign acc_type = sub_block.settings.content_type -%}
                  {%- assign acc_content = '' -%}

                  {%- if acc_type == 'custom' -%}
                    {%- assign acc_content = sub_block.settings.content -%}
                  {%- elsif acc_type == 'ingredients' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-ingredients', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'bundle' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-bundle', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'supplement_facts' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-supplement-facts', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- elsif acc_type == 'capsule_size' -%}
                    {%- capture rendered_snippet -%}
                      {%- render 'ww-product-capsule', product: current_prod -%}
                    {%- endcapture -%}
                    {%- assign acc_content = rendered_snippet | strip -%}
                  {%- endif -%}

                  {%- assign show_acc = false -%}
                  {%- if acc_content != blank -%}
                    {%- assign show_acc = true -%}
                  {%- endif -%}

                  {%- if show_acc -%}
                    <details class="ww-acc" {{ sub_block.shopify_attributes }}>
                      <summary>
                        <span class="ww-acc-plus">+</span>
                        <span class="ww-acc-t">{{ acc_title | escape }}</span>
                        {%- if sub_block.settings.items_count != blank -%}
                          <span class="ww-acc-c">{{ sub_block.settings.items_count | escape }}</span>
                        {%- elsif acc_type == 'ingredients' -%}
                          {%- assign ingredients_list = current_prod.metafields.custom.ingredients.value -%}
                          {%- if ingredients_list != blank -%}
                            <span class="ww-acc-c">{{ ingredients_list.size }} items</span>
                          {%- endif -%}
                        {%- elsif acc_type == 'bundle' -%}
                          {%- assign bundle_products = blank -%}
                          {%- assign bundle_rules = shop.metafields.appstle_bundles.bundle_rules.value -%}
                          {%- if bundle_rules != blank -%}
                            {%- for rule in bundle_rules -%}
                              {%- if rule.bundleProductId == current_prod.id or rule.productId == current_prod.id -%}
                                {%- assign bundle_products = rule.products -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {%- if bundle_products != blank -%}
                            {%- capture products_str -%}{{ bundle_products }}{%- endcapture -%}
                            {%- assign parts = products_str | split: '"productHandle":"' -%}
                            {%- assign parts_size = parts.size | minus: 1 -%}
                            {%- if parts_size > 0 -%}
                              <span class="ww-acc-c">{{ parts_size }} products</span>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      </summary>
                      <div class="ww-acc-body">
                        {{ acc_content }}
                      </div>
                    </details>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if section.settings.trust_heading != blank -%}
                <div class="ww-info-trust">
                  <div class="ww-info-trust-h">{{ section.settings.trust_heading | escape }}</div>
                  <div class="ww-info-trust-grid">
                    {%- if section.settings.trust_item_1_title != blank
                      or section.settings.trust_item_1_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_1_title != blank -%}
                          <h4>{{ section.settings.trust_item_1_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_1_text != blank -%}
                          <p>{{ section.settings.trust_item_1_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if section.settings.trust_item_2_title != blank
                      or section.settings.trust_item_2_text != blank
                    -%}
                      <div>
                        {%- if section.settings.trust_item_2_title != blank -%}
                          <h4>{{ section.settings.trust_item_2_title | escape }}</h4>
                        {%- endif -%}
                        {%- if section.settings.trust_item_2_text != blank -%}
                          <p>{{ section.settings.trust_item_2_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <!-- Close .ww-info -->
          </div>
          <!-- Close .ww-panel -->
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.enable_sticky_add_to_cart != false -%}
  <div class="ww-sticky-bar" id="ww-sticky-bar" data-section-id="{{ section.id }}" data-active="false">
    <div class="ww-sticky-bar__inner container">
      <div class="ww-sticky-bar__info">
        <h4 class="ww-sticky-bar__title"></h4>
        <div class="ww-sticky-bar__option-trigger">
          <span class="ww-sticky-bar__option-text"></span>
          <button type="button" class="ww-sticky-bar__change-btn">
            CHANGE <span class="arrow">▲</span>
          </button>
        </div>
        
        <!-- Option selector popover -->
        <div class="ww-sticky-bar__popover">
          <!-- Dynamic options will be rendered by JS -->
        </div>
      </div>
      
      <div class="ww-sticky-bar__actions">
        <button type="button" class="ww-sticky-bar__add-btn">
          <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
            {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
          </span>
          <span class="ww-sticky-bar__add-btn-text">Add to cart</span>
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

<script src="{{ 'ww-product.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('click', function (e) {
      const opt = e.target.closest('.ww-sub-opt');
      if (!opt) return;

      const radio = opt.querySelector('.ww-sub-opt__radio-input');
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }

      const container = opt.closest('.ww-purchase-options');
      if (container) {
        container.querySelectorAll('.ww-sub-opt').forEach((item) => item.classList.remove('on'));
      }
      opt.classList.add('on');
    });
  });
</script>
{% stylesheet %}
{% endstylesheet %}

{% schema %}
{
  "name": "WW Products Hub",
  "tag": "section",
  "class": "ww-section-products",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to travel with you"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each product comes in individually-sealed sachets.\nDesigned to toss in your bag and take on the go."
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Label",
      "default": "Plant-based"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Label",
      "default": "3rd-party tested"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Section Width",
      "options": [
        { "value": "page", "label": "Page width (max 1200px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Trust / Quality Badges Settings"
    },
    {
      "type": "text",
      "id": "trust_heading",
      "label": "Trust Section Heading",
      "default": "Commitment to Quality"
    },
    {
      "type": "text",
      "id": "trust_item_1_title",
      "label": "Trust Item 1 Title",
      "default": "Third-party testing"
    },
    {
      "type": "textarea",
      "id": "trust_item_1_text",
      "label": "Trust Item 1 Text",
      "default": "Every finished product lot is tested by independent labs for microbial contamination, heavy metals, and glyphosate. We also conduct third-party testing to verify that our products meet applicable label claims and potency specifications."
    },
    {
      "type": "text",
      "id": "trust_item_2_title",
      "label": "Trust Item 2 Title",
      "default": "Manufacturing excellence"
    },
    {
      "type": "textarea",
      "id": "trust_item_2_text",
      "label": "Trust Item 2 Text",
      "default": "Our products are manufactured in the U.S. in FDA-registered, NSF GMP-certified facilities with ingredients that are sourced globally."
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "Enable Sticky Add to Cart",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "product_tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "default": "Digestive Support"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Custom Subtitle",
          "default": "Capsules · Ginger"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "Travel can bring on digestive discomfort during or after a trip: bloating, irregularity, an upset stomach. Organic ginger root extract helps keep digestion steady wherever you're headed. We made the capsule small on purpose, so it's easy to take anywhere."
        },
        {
          "type": "range",
          "id": "sub_multiplier",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Subscription Pack Multiplier",
          "default": 1
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion Row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredients"
        },
        {
          "type": "text",
          "id": "items_count",
          "label": "Badge Count (e.g. \"4 items\")"
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "Content Source",
          "options": [
            { "value": "ingredients", "label": "Ingredients list (Default Template)" },
            { "value": "bundle", "label": "What's Inside (Bundle Products)" },
            { "value": "supplement_facts", "label": "Product Information / Facts (Default Template)" },
            { "value": "capsule_size", "label": "Capsule Size Scale Graphic" },
            { "value": "custom", "label": "Custom HTML Override" }
          ],
          "default": "ingredients"
        },
        {
          "type": "html",
          "id": "content",
          "label": "Custom Content HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Products Hub",
      "blocks": [
        {
          "type": "product_tab",
          "settings": {
            "title": "Digestive Support",
            "subtitle": "Capsules · Ginger",
            "description": "Travel can bring on digestive discomfort during or after a trip: bloating, irregularity, an upset stomach. Organic ginger root extract helps keep digestion steady wherever you're headed. We made the capsule small on purpose, so it's easy to take anywhere."
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Ingredients",
            "content_type": "ingredients"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Product Information",
            "content_type": "supplement_facts"
          }
