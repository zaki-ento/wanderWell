{% stylesheet %}
  .products {
    background-color: var(--offwhite);
  }
  .products-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
  }
  .products-header .section-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .products-header .section-title {
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--charcoal);
    margin: 0 0 12px;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .products-header .section-subtitle {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0 0 20px;
  }
  .products-badges {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .product-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-primary);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--charcoal);
    background-color: var(--cream);
    padding: 6px 12px;
    border-radius: 99px;
  }
  .product-badge svg {
    width: 14px;
    height: 14px;
    color: var(--orange);
  }

  .v2-shop {
    margin-top: 8px;
  }
  .v2-seg {
    display: flex;
    gap: 6px;
    background: #fff;
    border: 1px solid rgba(44,44,44,.1);
    border-radius: 999px;
    padding: 6px;
    max-width: 640px;
    margin: 0 auto 40px;
    box-shadow: 0 1px 4px rgba(28,28,26,.08);
  }
  .v2-seg-btn {
    flex: 1;
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 13px 10px;
    border-radius: 999px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .82rem;
    letter-spacing: .02em;
    color: var(--charcoal);
    text-transform: uppercase;
    transition: color .25s;
    min-height: 46px;
  }
  .v2-seg-btn .v2-seg-sub {
    display: block;
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: .62rem;
    letter-spacing: .06em;
    opacity: .6;
    margin-top: 2px;
    text-transform: none;
  }
  .v2-seg-btn.on {
    color: #fff;
  }
  .v2-seg-ind {
    position: absolute;
    top: 6px;
    bottom: 6px;
    border-radius: 999px;
    background: var(--orange);
    z-index: 0;
    transition: left .35s cubic-bezier(.4,0,.2,1), width .35s cubic-bezier(.4,0,.2,1);
    box-shadow: 0 4px 24px rgba(242,101,48,.2);
  }
  .v2-seg-wrap {
    position: relative;
  }

  .v2-panel {
    display: none;
    animation: v2-fade-up .5s cubic-bezier(.22,.61,.36,1);
  }
  .v2-panel.on {
    display: block;
  }
  @keyframes v2-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .v2-panel-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    background: #fff;
    border-radius: 24px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(28,28,26,.1);
    border: 1px solid rgba(44,44,44,.06);
  }

  /* Media side */
  .v2-media {
    position: relative;
  }
  .v2-media-main {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
  }
  .v2-media-stage {
    display: flex;
    width: 100%;
    aspect-ratio: 4/5;
    position: relative;
  }
  .v2-media-stage .v2-ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background-color: var(--cream);
    overflow: hidden;
  }
  .v2-media-stage .v2-ph.is-on {
    opacity: 1;
    visibility: visible;
    position: relative;
  }
  .v2-media-stage .v2-ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v2-ph--green {
    background: linear-gradient(135deg, #e3ede3 0%, #c8dcd0 100%) !important;
  }
  .v2-ph--warm {
    background: linear-gradient(135deg, #fbeee7 0%, #f4d4c5 100%) !important;
  }
  .v2-media-logo {
    position: relative;
    z-index: 2;
    width: 56%;
    opacity: .9;
  }
  
  .v2-media-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: background 0.2s, transform 0.2s;
  }
  .v2-media-nav:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.05);
  }
  .v2-media-nav svg {
    width: 18px;
    height: 18px;
    stroke: var(--charcoal);
    stroke-width: 2.5;
    fill: none;
  }
  .v2-media-nav--prev {
    left: 12px;
  }
  .v2-media-nav--next {
    right: 12px;
  }
  
  .v2-media-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .v2-media-thumbs .v2-ph {
    width: calc(25% - 6px);
    aspect-ratio: 1/1;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--cream);
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .v2-media-thumbs .v2-ph.is-active {
    border-color: var(--orange);
  }
  .v2-media-thumbs .v2-ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Detail side */
  .v2-detail-eyebrow {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 8px;
  }
  .v2-detail-title {
    font-family: var(--font-tertiary);
    font-weight: 500;
    font-size: 2.1rem;
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--charcoal);
    margin-bottom: 10px;
  }
  .v2-detail-lede {
    font-size: .98rem;
    line-height: 1.6;
    color: var(--charcoal-light);
    margin-bottom: 18px;
    letter-spacing: -.01em;
  }

  /* Buy box */
  .v2-buy {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid rgba(44,44,44,.12);
  }
  .v2-price-container {
    margin-bottom: 20px;
  }
  .v2-price-label {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--charcoal-light);
    display: block;
    margin-bottom: 2px;
    letter-spacing: 0.05em;
  }
  .v2-price-amount {
    font-family: var(--font-tertiary);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--charcoal);
    letter-spacing: -0.02em;
  }

  .v2-buy-row {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }
  .v2-qty {
    display: flex;
    align-items: center;
    border: 1.5px solid rgba(44,44,44,.15);
    border-radius: 999px;
    overflow: hidden;
    background: #fff;
  }
  .v2-qty button {
    border: none;
    background: transparent;
    width: 44px;
    height: 52px;
    font-size: 1.3rem;
    cursor: pointer;
    color: var(--charcoal);
    line-height: 1;
  }
  .v2-qty .v {
    min-width: 26px;
    text-align: center;
    font-weight: 700;
    font-family: var(--font-primary);
    font-size: 1rem;
    color: var(--charcoal);
  }
  .v2-add {
    flex: 1;
    border: none;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .95rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 52px;
    transition: background .2s, transform .1s;
  }
  .v2-add svg {
    width: 18px;
    height: 18px;
  }
  .v2-add:hover {
    background: var(--orange-dark);
  }
  .v2-add:active {
    transform: scale(.98);
  }
  .v2-add.is-added {
    background: #5AB08A !important;
  }
  .v2-buy-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
    font-family: var(--font-primary);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--charcoal-light);
  }
  .v2-buy-trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .v2-buy-trust svg {
    width: 14px;
    height: 14px;
    color: var(--orange);
  }

  /* Info and Accordions */
  .v2-info {
    margin-top: 24px;
  }
  .v2-acc {
    border-bottom: 1px solid rgba(44,44,44,.1);
    padding: 18px 0;
  }
  .v2-acc:first-child {
    border-top: 1px solid rgba(44,44,44,.1);
  }
  .v2-acc summary {
    list-style: none;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--charcoal);
  }
  .v2-acc summary::-webkit-details-marker {
    display: none;
  }
  .v2-acc-plus {
    font-size: 1.25rem;
    margin-right: 12px;
    color: var(--orange);
    font-weight: 600;
    transition: transform 0.25s;
    line-height: 1;
  }
  .v2-acc[open] .v2-acc-plus {
    transform: rotate(45deg);
  }
  .v2-acc-t {
    flex: 1;
  }
  .v2-acc-c {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--charcoal-light);
    background: var(--cream);
    padding: 4px 10px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .v2-acc-body {
    padding: 16px 12px 8px;
    animation: v2-fade-in .3s ease-out;
  }
  @keyframes v2-fade-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .v2-ing {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(44,44,44,.08);
  }
  .v2-ing:last-child {
    border-bottom: none;
  }
  .v2-ing-dot {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--orange);
    margin-top: 5px;
  }
  .v2-ing h4 {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: .92rem;
    color: var(--charcoal);
    margin: 0 0 3px;
    letter-spacing: -.01em;
  }
  .v2-ing p {
    font-size: .85rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0;
  }
  .v2-ing .amt {
    font-family: var(--font-primary);
    font-size: .72rem;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: .04em;
    margin-left: 6px;
  }

  .v2-sf-panel {
    background: var(--cream);
    border-radius: 16px;
    padding: 16px;
    margin-top: 14px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .v2-sf-h {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 10px;
    color: var(--charcoal);
    border-bottom: 2px solid var(--charcoal);
    padding-bottom: 6px;
  }
  .v2-sf-meta {
    font-size: 0.8rem;
    color: var(--charcoal);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .v2-sf-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid rgba(44,44,44,0.12);
    font-size: 0.8rem;
  }
  .v2-sf-row span:nth-child(1) {
    flex: 1;
    font-weight: 500;
    color: var(--charcoal);
  }
  .v2-sf-row span:nth-child(2) {
    width: 90px;
    text-align: right;
    font-weight: 600;
  }
  .v2-sf-row span:nth-child(3) {
    width: 60px;
    text-align: right;
    font-weight: 600;
  }
  .v2-sf-row--h {
    font-weight: 700;
    border-bottom: 1.5px solid var(--charcoal);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
  .v2-sf-row--h span {
    color: var(--charcoal) !important;
  }
  .v2-sf-note {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--charcoal-light);
    margin: 8px 0 0;
  }

  .v2-capsize {
    background: var(--cream);
    border-radius: 16px;
    padding: 16px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .v2-capsize-h {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--charcoal);
    margin-bottom: 6px;
  }
  .v2-capsize-sub {
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--charcoal-light);
    margin: 0 0 16px;
  }
  .v2-capsize-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .v2-caprow {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .v2-caplabel {
    width: 90px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--charcoal-light);
    line-height: 1.1;
  }
  .v2-caplabel small {
    display: block;
    font-size: 0.68rem;
    font-weight: 500;
    opacity: 0.8;
  }
  .v2-caplabel--ours {
    color: var(--orange);
  }
  .v2-capbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }
  .v2-cap {
    background: #c3d9c7;
    border-radius: 99px;
    position: relative;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .v2-caprow--ours .v2-cap {
    background: var(--orange);
  }
  .v2-capdim {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--charcoal-light);
  }

  .v2-info-trust {
    margin-top: 24px;
    background: var(--cream);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .v2-info-trust-h {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 1rem;
    color: var(--charcoal);
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding-bottom: 8px;
  }
  .v2-info-trust-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .v2-info-trust-grid h4 {
    font-family: var(--font-tertiary);
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 4px;
    color: var(--charcoal);
  }
  .v2-info-trust-grid p {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--charcoal-light);
    margin: 0;
  }

  /* Steps and Bundles */
  .v2-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .v2-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .v2-step-n {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--orange);
    font-family: var(--font-tertiary);
    font-weight: 700;
    display: grid;
    place-items: center;
    font-size: .9rem;
  }
  .v2-step h4 {
    font-size: .92rem;
    font-weight: 700;
    color: var(--charcoal);
    margin: 2px 0 2px;
  }
  .v2-step p {
    font-size: .85rem;
    line-height: 1.5;
    color: var(--charcoal-light);
    margin: 0;
  }
  .v2-steps-note {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--charcoal-light);
    margin: 8px 0 0;
  }

  .v2-bundle-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .v2-bundle-item {
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--cream);
    border-radius: 14px;
    padding: 12px;
  }
  .v2-bundle-item .v2-ph {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-color: var(--cream);
    background-size: cover;
    background-position: center;
  }
  .v2-bundle-item .v2-ph:nth-child(1) {
    background-color: #c8dcd0;
  }
  .v2-bundle-item .v2-ph:nth-child(2) {
    background-color: #fbeee7;
  }
  .v2-bundle-item h4 {
    font-family: var(--font-tertiary);
    font-size: .95rem;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 2px;
  }
  .v2-bundle-item p {
    font-size: .8rem;
    color: var(--charcoal-light);
    margin: 0;
  }
  .v2-bundle-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--orange-pale);
    color: var(--orange-dark);
    border-radius: 12px;
    padding: 10px 14px;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: .85rem;
    margin-top: 14px;
  }

  /* Responsive styles */
  @media screen and (min-width: 760px) {
    .products-header .section-title {
      font-size: 3rem;
    }
    .v2-panel-inner {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 36px;
      padding: 28px;
    }
    .v2-detail-title {
      font-size: 2.6rem;
    }
    .v2-info {
      margin-top: 36px;
    }
    .v2-info-trust-grid {
      flex-direction: row;
      gap: 24px;
    }
    .v2-info-trust-grid > div {
      flex: 1;
    }
  }

  @media screen and (min-width: 1024px) {
    .v2-detail-title {
      font-size: 3rem;
    }
    .v2-panel-inner {
      padding: 36px;
      gap: 48px;
    }
  }

  @media screen and (max-width: 759px) {
    .v2-seg {
      max-width: 100%;
    }
    .v2-seg-btn {
      font-size: .72rem;
      padding: 11px 4px;
    }
    .v2-buy-row {
      flex-wrap: wrap;
    }
    .v2-add {
      flex: 1 1 100%;
      order: 2;
    }
    .v2-qty {
      order: 1;
    }
  }
{% endstylesheet %}

