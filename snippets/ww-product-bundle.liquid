{% comment %}
  Snippet: WW Product Bundle Items
  Renders product components inside a bundle dynamically from custom metafield references.
  Accepts: product
{% endcomment %}

{%- liquid
  assign is_bundle = false
  assign bundle_items = product.metafields.custom.bundle_products.value
  
  if bundle_items != blank
    assign is_bundle = true
  elsif product.metafields.custom.bundle_product_1.value != blank or product.metafields.custom.bundle_product_2.value != blank
    assign is_bundle = true
  endif
-%}

{%- if is_bundle -%}
  <div class="ww-bundle-items">
    {%- assign original_total_price = 0 -%}
    
    {%- if bundle_items != blank -%}
      {%- for bundle_product in bundle_items -%}
        {%- if bundle_product != blank -%}
          {%- assign item_title = bundle_product.title -%}
          {%- assign item_image = bundle_product.featured_media -%}
          {%- assign item_description = bundle_product.metafields.custom.short_description.value | default: bundle_product.metafields.custom.subtitle -%}
          {%- assign original_total_price = original_total_price | plus: bundle_product.price -%}
          
          <div class="ww-bundle-item">
            <div class="ww-bundle-thumb">
              {%- if item_image != blank -%}
                {{ item_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: item_title }}
              {%- else -%}
                <div class="ww-bundle-ph"></div>
              {%- endif -%}
            </div>
            <div>
              <h4>{{ item_title | escape }}</h4>
              {%- if item_description != blank -%}
                <p>{{ item_description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- if product.metafields.custom.bundle_product_1.value != blank -%}
        {%- assign bundle_product = product.metafields.custom.bundle_product_1.value -%}
        {%- assign item_title = bundle_product.title -%}
        {%- assign item_image = bundle_product.featured_media -%}
        {%- assign item_description = bundle_product.metafields.custom.short_description.value | default: bundle_product.metafields.custom.subtitle -%}
        {%- assign original_total_price = original_total_price | plus: bundle_product.price -%}
        
        <div class="ww-bundle-item">
          <div class="ww-bundle-thumb">
            {%- if item_image != blank -%}
              {{ item_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: item_title }}
            {%- else -%}
              <div class="ww-bundle-ph"></div>
            {%- endif -%}
          </div>
          <div>
            <h4>{{ item_title | escape }}</h4>
            {%- if item_description != blank -%}
              <p>{{ item_description | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
      
      {%- if product.metafields.custom.bundle_product_2.value != blank -%}
        {%- assign bundle_product = product.metafields.custom.bundle_product_2.value -%}
        {%- assign item_title = bundle_product.title -%}
        {%- assign item_image = bundle_product.featured_media -%}
        {%- assign item_description = bundle_product.metafields.custom.short_description.value | default: bundle_product.metafields.custom.subtitle -%}
        {%- assign original_total_price = original_total_price | plus: bundle_product.price -%}
        
        <div class="ww-bundle-item">
          <div class="ww-bundle-thumb">
            {%- if item_image != blank -%}
              {{ item_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: item_title }}
            {%- else -%}
              <div class="ww-bundle-ph"></div>
            {%- endif -%}
          </div>
          <div>
            <h4>{{ item_title | escape }}</h4>
            {%- if item_description != blank -%}
              <p>{{ item_description | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
    
    {%- assign bundle_total_price = product.price -%}
    {%- if original_total_price > bundle_total_price -%}
      {%- assign discount_amount = original_total_price | minus: bundle_total_price -%}
      <div class="ww-bundle-save">
        You save {{ discount_amount | money }} vs. buying separately
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
