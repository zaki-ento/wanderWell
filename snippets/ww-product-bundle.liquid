{% comment %}
  Snippet: WW Product Bundle Items
  Renders product components inside a bundle dynamically from custom metafield references.
  Accepts: product
{% endcomment %}

{%- liquid
  assign has_custom_bundle = false
  assign custom_products = product.metafields.custom.bundle_products.value
  
  if custom_products != blank
    assign has_custom_bundle = true
  elsif product.metafields.custom.bundle_product_1.value != blank or product.metafields.custom.bundle_product_2.value != blank
    assign has_custom_bundle = true
  endif
-%}

{%- if has_custom_bundle -%}
  <div class="ww-bundle-items">
    {%- assign total_individual_price = 0 -%}
    
    {%- if custom_products != blank -%}
      {%- for prod_item in custom_products -%}
        {%- if prod_item != blank -%}
          {%- assign prod_title = prod_item.title -%}
          {%- assign prod_image = prod_item.featured_media -%}
          {%- assign prod_subtitle = prod_item.metafields.custom.short_description.value | default: prod_item.metafields.custom.subtitle -%}
          {%- assign total_individual_price = total_individual_price | plus: prod_item.price -%}
          
          <div class="ww-bundle-item">
            <div class="ww-bundle-thumb">
              {%- if prod_image != blank -%}
                {{ prod_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod_title }}
              {%- else -%}
                <div class="ww-bundle-ph"></div>
              {%- endif -%}
            </div>
            <div>
              <h4>{{ prod_title | escape }}</h4>
              {%- if prod_subtitle != blank -%}
                <p>{{ prod_subtitle | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- if product.metafields.custom.bundle_product_1.value != blank -%}
        {%- assign prod_item = product.metafields.custom.bundle_product_1.value -%}
        {%- assign prod_title = prod_item.title -%}
        {%- assign prod_image = prod_item.featured_media -%}
        {%- assign prod_subtitle = prod_item.metafields.custom.short_description.value | default: prod_item.metafields.custom.subtitle -%}
        {%- assign total_individual_price = total_individual_price | plus: prod_item.price -%}
        
        <div class="ww-bundle-item">
          <div class="ww-bundle-thumb">
            {%- if prod_image != blank -%}
              {{ prod_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod_title }}
            {%- else -%}
              <div class="ww-bundle-ph"></div>
            {%- endif -%}
          </div>
          <div>
            <h4>{{ prod_title | escape }}</h4>
            {%- if prod_subtitle != blank -%}
              <p>{{ prod_subtitle | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
      
      {%- if product.metafields.custom.bundle_product_2.value != blank -%}
        {%- assign prod_item = product.metafields.custom.bundle_product_2.value -%}
        {%- assign prod_title = prod_item.title -%}
        {%- assign prod_image = prod_item.featured_media -%}
        {%- assign prod_subtitle = prod_item.metafields.custom.short_description.value | default: prod_item.metafields.custom.subtitle -%}
        {%- assign total_individual_price = total_individual_price | plus: prod_item.price -%}
        
        <div class="ww-bundle-item">
          <div class="ww-bundle-thumb">
            {%- if prod_image != blank -%}
              {{ prod_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod_title }}
            {%- else -%}
              <div class="ww-bundle-ph"></div>
            {%- endif -%}
          </div>
          <div>
            <h4>{{ prod_title | escape }}</h4>
            {%- if prod_subtitle != blank -%}
              <p>{{ prod_subtitle | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
    
    {%- assign bundle_price = product.selected_or_first_available_variant.price | default: product.price -%}
    {%- if total_individual_price > bundle_price -%}
      {%- assign save_amount = total_individual_price | minus: bundle_price -%}
      <div class="ww-bundle-save">
        You save {{ save_amount | money }} vs. buying separately
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
