{% comment %}
  Snippet: WW Payment Icons
  Description: Renders payment method badges (Visa, Mastercard, Amex, Apple Pay, Shop Pay, PayPal) matching brand design.
{% endcomment %}

<div class="ww-payment-icons" aria-label="Accepted payment methods">
  <ul class="ww-payment-icons__list" role="list">
    <!-- Visa -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--visa" title="Visa">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa">
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-weight="900" font-style="italic" font-size="11" fill="#1434CB" letter-spacing="1">VISA</text>
        </svg>
      </div>
    </li>

    <!-- Mastercard -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--mastercard" title="Mastercard">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard">
          <circle cx="15" cy="12" r="7" fill="#EB001B" />
          <circle cx="23" cy="12" r="7" fill="#F79E1B" fill-opacity="0.9" />
        </svg>
      </div>
    </li>

    <!-- American Express -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--amex" title="American Express">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Amex">
          <rect width="38" height="24" rx="4" fill="#006FCF"/>
          <text x="50%" y="53%" dominant-baseline="middle" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-weight="800" font-size="8" fill="#FFFFFF" letter-spacing="0.5">AMEX</text>
        </svg>
      </div>
    </li>

    <!-- Apple Pay -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--apple-pay" title="Apple Pay">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Apple Pay">
          <path d="M12.7 11.2c-.1-1.3 1-2 1.1-2-.6-.9-1.5-1-1.8-1-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-2.9-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.6 2.3 2.8 2.2 1.1 0 1.6-.7 2.9-.7 1.3 0 1.7.7 2.9.7 1.2 0 2-1.1 2.7-2.2.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.4-.9-2.4-3.6z" fill="#000" transform="translate(4, -1) scale(0.65)"/>
          <path d="M12.1 6.8c.5-.7.9-1.6.8-2.5-.8 0-1.7.5-2.2 1.2-.5.6-.9 1.5-.8 2.5.9.1 1.7-.5 2.2-1.2z" fill="#000" transform="translate(4, -1) scale(0.65)"/>
          <text x="25" y="13.5" dominant-baseline="middle" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="600" font-size="8.5" fill="#000">Pay</text>
        </svg>
      </div>
    </li>

    <!-- Shop Pay -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--shop-pay" title="Shop Pay">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Shop Pay">
          <rect width="38" height="24" rx="4" fill="#5A31F4"/>
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-weight="700" font-size="7.5" fill="#FFFFFF" letter-spacing="-0.2">shop Pay</text>
        </svg>
      </div>
    </li>

    <!-- PayPal -->
    <li class="ww-payment-icons__item">
      <div class="ww-payment-badge ww-payment-badge--paypal" title="PayPal">
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PayPal">
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-weight="900" font-style="italic" font-size="8.5">
            <tspan fill="#003087">Pay</tspan><tspan fill="#0079C1">Pal</tspan>
          </text>
        </svg>
      </div>
    </li>
  </ul>
</div>
