  {% endstyle %}

  <script>
    (function () {
      function initFrequencyPills() {
        var pills = document.querySelectorAll('.ww-purchase-options--v2 .ww-sub-opt__freq-pill');
        pills.forEach(function (pill) {
          if (pill.__wwBound) return;
          pill.__wwBound = true;

          pill.addEventListener('click', function (e) {
            e.stopPropagation();

            var radioInput = pill.querySelector('.ww-sub-opt__freq-radio');
            var planId = pill.getAttribute('data-plan-id') || (radioInput ? radioInput.getAttribute('data-plan-id') : '');
            var intervalText = pill.getAttribute('data-interval-text') || (radioInput ? radioInput.getAttribute('data-interval-text') : '');

            var container = pill.closest('.ww-purchase-options--v2');
            if (!container) return;

            var subCard = container.querySelector('.ww-sub-opt[data-option-type="subscription"]');
            var form = container.closest('form');

            // 1. Update active pill in this bar
            var bar = pill.closest('.ww-sub-opt__freq-bar');
            if (bar) {
              bar.querySelectorAll('.ww-sub-opt__freq-pill').forEach(function (p) {
                p.classList.remove('is-active');
                var r = p.querySelector('.ww-sub-opt__freq-radio');
                if (r) r.checked = false;
              });
            }
            pill.classList.add('is-active');
            if (radioInput) radioInput.checked = true;

            // 2. Update selling plan on card and radio
            if (subCard && planId) {
              subCard.setAttribute('data-selling-plan-id', planId);
              var subRadio = subCard.querySelector('input[type="radio"][value="subscription"]');
              if (subRadio) {
                subRadio.setAttribute('data-selling-plan-id', planId);
                if (!subRadio.checked) {
                  subRadio.checked = true;
                  subRadio.dispatchEvent(new Event('change', { bubbles: true }));
                }
              }
            }

            // 3. Update hidden selling_plan input in the form
            if (form && planId) {
              var sellingPlanInput = form.querySelector('input.ww-selling-plan-input') || form.querySelector('input[name="selling_plan"]');
              if (sellingPlanInput) {
                sellingPlanInput.value = planId;
                sellingPlanInput.removeAttribute('disabled');
              }
            }

            // 4. Update cadence text in servings label
            if (subCard && intervalText) {
              var cadenceEl = subCard.querySelector('.ww-sub-opt__cadence-text');
              if (cadenceEl) {
                cadenceEl.textContent = intervalText;
              }
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFrequencyPills);
      } else {
        initFrequencyPills();
      }
      document.addEventListener('shopify:section:load', initFrequencyPills);
    })();
  </script>
{%- endif -%}
