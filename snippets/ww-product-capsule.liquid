{% comment %}
  Snippet: WW Product Capsule Size-Scale Visual
  Renders capsule dimensions comparison visualization chart dynamically from product metafields.
  Accepts: product

  ========================================================================================
  SHOPIFY ADMIN CUSTOM DATA CONFIGURATION GUIDE FOR CAPSULE SIZE:
  ========================================================================================
  1. CREATE THE PRODUCT METAFIELDS:
     - Go to: Settings > Custom data > Products > Add definition.
     
     a. Capsule Size (Single line text):
        - Name: "Capsule Size"
        - Namespace and key: "custom.capsule_size"
        - Description: Set value to e.g., "Size 4", "Size 3", "Size 2", "Size 1", "Size 0", or "Size 00".
        
     b. Capsule Dimensions (Single line text):
        - Name: "Capsule Dimensions"
        - Namespace and key: "custom.capsule_dimensions"
        - Description: Set value to e.g., "14.3 × 5.31 mm".
        
     c. Capsule Details (Rich Text):
        - Name: "Capsule Details"
        - Namespace and key: "custom.capsule_details"
        - Description: Custom description text for the capsule accordion.
        
  2. ADD DATA TO PRODUCTS:
     - Go to any Product page in your Admin, scroll to the bottom Metafields section,
       and fill in your product's Capsule Size, Capsule Dimensions, and Capsule Details values!
  ========================================================================================
{% endcomment %}

{%- if product.metafields.custom.capsule_size != blank -%}
  {%- style -%}
    .ww-capsize {
      background: var(--cream);
      border-radius: 16px;
      padding: 16px;
      border: 1px solid rgba(0,0,0,0.05);
    }
    .ww-capsize-h {
      font-family: var(--font-tertiary);
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--charcoal);
      margin-bottom: 6px;
    }
    .ww-capsize-sub {
      font-size: 0.82rem;
      line-height: 1.4;
      color: var(--charcoal-light);
      margin: 0 0 16px;
    }
    .ww-capsize-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .ww-caprow {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .ww-caplabel {
      width: 90px;
      font-family: var(--font-primary);
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--charcoal-light);
      line-height: 1.1;
    }
    .ww-caplabel small {
      display: block;
      font-size: 0.68rem;
      font-weight: 500;
      opacity: 0.8;
    }
    .ww-caplabel--ours {
      color: var(--orange);
    }
    .ww-capbar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
    }
    .ww-cap {
    position: relative;
    border-radius: 999px;
    background: #D8D5CE;
    flex: none;
    }

    .ww-cap::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 42%;
    border-radius: 999px 40% 40% 999px/999px 50% 50% 999px;
    background: #C2BEB5;
    }
    .ww-caprow--ours .ww-cap {
      background: #F5C49A;
    }
    .ww-caprow--ours .ww-cap::before {
     background: var(--orange);
    }
    .ww-capdim {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--charcoal-light);
    }
  {%- endstyle -%}
  {%- assign capsule_size = product.metafields.custom.capsule_size.value | default: product.metafields.custom.capsule_size -%}
  {%- assign capsule_size_clean = capsule_size | downcase | remove: ' ' -%}
  {%- assign capsule_dimensions = product.metafields.custom.capsule_dimensions.value | default: product.metafields.custom.capsule_dimensions -%}
  {%- assign capsule_details_mf = product.metafields.custom.capsule_details -%}

  {%- if capsule_dimensions == blank -%}
    {%- if capsule_size_clean == 'size4' -%}
      {%- assign capsule_dimensions = '14.3 × 5.31 mm' -%}
    {%- elsif capsule_size_clean == 'size3' -%}
      {%- assign capsule_dimensions = '15.9 × 5.82 mm' -%}
    {%- elsif capsule_size_clean == 'size2' -%}
      {%- assign capsule_dimensions = '18.0 × 6.35 mm' -%}
    {%- elsif capsule_size_clean == 'size1' -%}
      {%- assign capsule_dimensions = '19.4 × 6.91 mm' -%}
    {%- elsif capsule_size_clean == 'size0' -%}
      {%- assign capsule_dimensions = '21.7 × 7.64 mm' -%}
    {%- elsif capsule_size_clean == 'size00' -%}
      {%- assign capsule_dimensions = '23.3 × 8.53 mm' -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign style_w_h = 'width:114px;height:42px' -%}
  {%- if capsule_size_clean == 'size4' -%}
    {%- assign style_w_h = 'width:114px;height:42px' -%}
  {%- elsif capsule_size_clean == 'size3' -%}
    {%- assign style_w_h = 'width:127px;height:46px' -%}
  {%- elsif capsule_size_clean == 'size2' -%}
    {%- assign style_w_h = 'width:144px;height:51px' -%}
  {%- elsif capsule_size_clean == 'size1' -%}
    {%- assign style_w_h = 'width:155px;height:55px' -%}
  {%- elsif capsule_size_clean == 'size0' -%}
    {%- assign style_w_h = 'width:174px;height:61px' -%}
  {%- elsif capsule_size_clean == 'size00' -%}
    {%- assign style_w_h = 'width:186px;height:68px' -%}
  {%- endif -%}

  <div class="ww-capsize">
    <div class="ww-capsize-h">Capsule size, to scale</div>
    {%- if capsule_details_mf != blank -%}
      <div class="ww-capsize-sub ww-rich-text">
        {{ capsule_details_mf | metafield_tag }}
      </div>
    {%- else -%}
      <p class="ww-capsize-sub">We wanted a capsule you don't have to psych yourself up for. So we made ours small enough to swallow without thinking about it. See for yourself.</p>
    {%- endif -%}
    
    <div class="ww-capsize-rows">
      <div class="ww-caprow ww-caprow--ours">
        <div class="ww-caplabel ww-caplabel--ours">
          {%- if settings.logo_inverse != blank -%}
            {{ settings.logo_inverse | image_url: width: 80 | image_tag: style: 'height:10px; width:auto; display:inline-block; margin-right:4px;' }}
          {%- else -%}
            <span>wanderWell</span>
          {%- endif -%}
          <small>{{ capsule_size | escape }}</small>
        </div>
        <div class="ww-capbar">
          <div class="ww-cap" style="{{ style_w_h }}"></div>
          <span class="ww-capdim">{{ capsule_dimensions | escape }}</span>
        </div>
      </div>
      
      <div class="ww-caprow">
        <div class="ww-caplabel">Common<small>Size 1</small></div>
        <div class="ww-capbar">
          <div class="ww-cap" style="width:155px;height:55px"></div>
          <span class="ww-capdim">19.4 × 6.91 mm</span>
        </div>
      </div>
      
      <div class="ww-caprow">
        <div class="ww-caplabel">Common<small>Size 0</small></div>
        <div class="ww-capbar">
          <div class="ww-cap" style="width:174px;height:61px"></div>
          <span class="ww-capdim">21.7 × 7.64 mm</span>
        </div>
      </div>
      
      <div class="ww-caprow">
        <div class="ww-caplabel">Typical<small>Size 00</small></div>
        <div class="ww-capbar">
          <div class="ww-cap" style="width:186px;height:68px"></div>
          <span class="ww-capdim">23.3 × 8.53 mm</span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
