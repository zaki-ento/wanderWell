{% comment %}
  Snippet: WW CSS Variables
  Description: Loads WanderWell Brand CSS Variables and font-face declarations.
{% endcomment %}

{% style %}
  /* ============================================
     LOCAL FONT FACE DECLARATIONS
     ============================================ */

  /* Sofia Pro Regular (400) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-400.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  /* Sofia Pro Regular Italic (400 Italic) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-400-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  /* Sofia Pro Medium Italic (500 Italic) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-500-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }
  /* Sofia Pro Semibold (600) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-600.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  /* Sofia Pro Semibold Italic (600 Italic) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-600-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: italic;
    font-display: swap;
  }
  /* Sofia Pro Bold (700) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-700.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  /* Sofia Pro Bold Italic (700 Italic) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-700-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }
  /* Sofia Pro Ultra/Black (900) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-900.woff2' | asset_url }}") format("woff2");
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }
  /* Sofia Pro Ultra/Black Italic (900 Italic) */
  @font-face {
    font-family: "sofia-pro";
    src: url("{{ 'sofia-pro-900-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 900;
    font-style: italic;
    font-display: swap;
  }

  /* Montserrat Regular (400) */
  @font-face {
    font-family: "Montserrat";
    src: url("{{ 'montserrat-400.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  /* Montserrat Medium (500) */
  @font-face {
    font-family: "Montserrat";
    src: url("{{ 'montserrat-500.woff2' | asset_url }}") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  /* Montserrat Semibold (600) */
  @font-face {
    font-family: "Montserrat";
    src: url("{{ 'montserrat-600.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  /* Montserrat Bold (700) */
  @font-face {
    font-family: "Montserrat";
    src: url("{{ 'montserrat-700.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  
  {%- assign font_body_bold = settings.font_body | font_modify: 'weight', 'bold' -%}
  {%- if font_body_bold -%}
    {{ font_body_bold | font_face: font_display: 'swap' }}
  {%- endif -%}

  {%- assign font_body_italic = settings.font_body | font_modify: 'style', 'italic' -%}
  {%- if font_body_italic -%}
    {{ font_body_italic | font_face: font_display: 'swap' }}
  {%- endif -%}

  :root {
    /* Page Layout  set 75rem for 1200px container */
    --narrow-page-width: 75rem;
    --normal-content-width: 45rem;
    --ww-letter-spacing: 0.12em;
    --ww-color-primary: {{ settings.color_primary | default: '#E8632B' }};
    --ww-color-background: {{ settings.color_background | default: '#E8E0D0' }};
    --ww-color-text: {{ settings.color_text | default: '#1A1A1A' }};
    --ww-color-text-light: {{ settings.color_text_light | default: '#5C5C5C' }};
    --ww-color-white: #FFFFFF;
    --ww-color-border: rgba(44, 44, 44, 0.15);

    --ww-font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
    --ww-font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};

    --ww-space-xs: 0.5rem;
    --ww-space-sm: 1rem;
    --ww-space-md: 1.5rem;
    --ww-space-lg: 2.5rem;
    --ww-space-xl: 4rem;

    --ww-radius: 8px;
    --ww-radius-lg: 16px;
    
    /* Mapping to design tokens */
    --orange:          var(--ww-color-primary);
    --orange-dark:     {{ settings.color_primary_dark | default: '#D15523' }};
    --orange-light:    {{ settings.color_primary_light | default: '#F0845A' }};
    --orange-pale:     {{ settings.color_primary_pale | default: '#FCEEE7' }};

    --charcoal:        var(--ww-color-text);
    --charcoal-light:  var(--ww-color-text-light);
    
    --offwhite:        #E8E0D0;
    --cream:           #F2EDE4;
    --white:           #FFFFFF;
    --black:           #000000;
    
    --font-primary:    'sofia-pro', 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-tertiary:   'sofia-pro', 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --ww-footer-bg:    linear-gradient(180deg, #FBCBA8 0%, #E8632B 100%);

    /* Screen Breakpoints */
    --breakpoint-sm: 640px;
    --breakpoint-md: 768px;
    --breakpoint-lg: 1024px;
    --breakpoint-xl: {{ settings.container_width | default: 1200 }}px;
    --breakpoint-2xl: 1536px;


    /* Logo size */
    --ww-header-logo-image-height: 32px;
  }


  @media screen and (min-width: 750px) {
    .header-logo__image {
      max-height: var(--ww-header-logo-image-height) !important;
      height: auto !important;
      width: auto !important;
    }
}

  .container {
    max-width: 1200px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  @media screen and (min-width: 640px) {
    .container {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  
.custom-typography,
.custom-typography > * {
  letter-spacing: var(--ww-letter-spacing);
  font-family: var(--font-primary);
}

  /* Unified Breakpoint Max-Width Utility Classes */
  .max-w-breakpoint-sm { max-width: var(--breakpoint-sm); }
  .max-w-breakpoint-md { max-width: var(--breakpoint-md); }
  .max-w-breakpoint-lg { max-width: var(--breakpoint-lg); }
  .max-w-breakpoint-xl { max-width: var(--breakpoint-xl); }
  .max-w-breakpoint-2xl { max-width: var(--breakpoint-2xl); }

  /* Brand Typography Base Resets */
  h1, h2, h3, h4, h5, h6,
  .h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: var(--font-tertiary);
  }

  body, p, span, div, a, li, input, textarea, button {
    font-family: var(--font-primary);
  }

{% endstyle %}
